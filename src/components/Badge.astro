---
/** Thin wrapper over the global `.badge` classes in global.css. */
interface Props {
  text: string;
  variant?: "default" | "brand" | "tip" | "warning" | "danger" | "info";
}

const { text, variant = "default" } = Astro.props;
---

<span class:list={["badge", variant !== "default" && `badge--${variant}`]}>{text}</span>
