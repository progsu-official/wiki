---

---

<div
  class="sitesearch-backdrop"
  id="sitesearch-backdrop"
  role="dialog"
  aria-label="Search"
  aria-modal="true"
>
  <div class="sitesearch-panel">
    <div class="sitesearch-input-row">
      <svg
        class="sitesearch-icon"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
      </svg>
      <input
        id="sitesearch-input"
        class="sitesearch-input"
        type="text"
        placeholder="search guides and categories"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="sitesearch-esc">esc</kbd>
    </div>
    <ul class="sitesearch-results" id="sitesearch-results"></ul>
    <div class="sitesearch-hints">
      <span class="sitesearch-hint"><kbd>&uarr;</kbd><kbd>&darr;</kbd> to navigate</span>
      <span class="sitesearch-hint"><kbd>&crarr;</kbd> to select</span>
      <span class="sitesearch-hint"><kbd>esc</kbd> to close</span>
    </div>
  </div>
</div>

<style>
  .sitesearch-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    background: rgba(0, 0, 0, 0.6);
    padding: var(--space-20) var(--space-5) var(--space-8);
    overflow-y: auto;
  }
  .sitesearch-backdrop.open {
    display: block;
  }

  .sitesearch-panel {
    display: flex;
    flex-direction: column;
    max-width: 640px;
    max-height: calc(100vh - var(--space-20) - var(--space-8));
    margin: 0 auto;
    /* The panel is elevated, so it takes the elevated surface: on the grey
       theme --c-bg would be the page ground showing through the scrim. */
    background: var(--c-bg-elv);
    border: 1px solid var(--c-divider);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xl);
    overflow: hidden;
  }

  .sitesearch-input-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--c-divider);
    flex-shrink: 0;
  }

  .sitesearch-icon {
    color: var(--c-text-3);
    flex-shrink: 0;
  }

  .sitesearch-input {
    flex: 1;
    min-width: 0;
    background: none;
    border: none;
    outline: none;
    color: var(--c-text-1);
    font-family: var(--font-body);
    font-size: 16px;
  }
  .sitesearch-input::placeholder {
    color: var(--c-text-3);
  }

  .sitesearch-esc {
    flex-shrink: 0;
    padding: 2px var(--space-2);
    border: 1px solid var(--c-divider);
    border-radius: var(--radius-sm);
    background: var(--c-bg-mute);
    color: var(--c-text-3);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.5;
  }

  .sitesearch-results {
    list-style: none;
    margin: 0;
    padding: var(--space-2);
    flex: 1;
    overflow-y: auto;
  }

  .sitesearch-hints {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-5);
    border-top: 1px solid var(--c-divider);
    background: var(--c-bg-alt);
    flex-shrink: 0;
  }

  .sitesearch-hint {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: 12px;
    color: var(--c-text-3);
  }
  .sitesearch-hint kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    border: 1px solid var(--c-divider);
    border-radius: var(--radius-sm);
    background: var(--c-bg-mute);
    color: var(--c-text-3);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
  }

  /* Rows are injected by the script below, so their styles must stay global. */
  :global(.sitesearch-group-label) {
    padding: var(--space-3) var(--space-3) var(--space-1);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--c-text-3);
  }

  :global(.sitesearch-item) {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-3);
    border-radius: var(--radius-md);
    cursor: pointer;
  }
  :global(.sitesearch-item.active) {
    background: var(--c-brand-soft);
    color: var(--c-brand-1);
  }

  :global(.sitesearch-item-title) {
    flex: 1;
    min-width: 0;
    font-size: 14px;
    font-weight: 600;
    color: var(--c-text-1);
  }
  :global(.sitesearch-item.active .sitesearch-item-title) {
    color: var(--c-brand-1);
  }

  :global(.sitesearch-item-meta) {
    flex-shrink: 0;
    font-size: 12px;
    color: var(--c-text-3);
  }
  :global(.sitesearch-item.active .sitesearch-item-meta) {
    color: var(--c-brand-1);
  }

  :global(.sitesearch-empty) {
    padding: var(--space-10) var(--space-6);
    text-align: center;
    font-size: 14px;
    color: var(--c-text-3);
  }

  @media (max-width: 767px) {
    .sitesearch-backdrop {
      padding: 0;
      overflow: hidden;
    }

    .sitesearch-panel {
      max-width: none;
      height: 100%;
      max-height: none;
      border: none;
      border-radius: 0;
    }
  }
</style>

<script>
  type Container = { type: "container"; title: string; href: string };
  type Page = { type: "page"; title: string; href: string; category: string; tags: string[] };

  let data: { containers: Container[]; pages: Page[] } | null = null;
  let flat: (Container | Page)[] = [];
  let activeIndex = 0;

  const backdrop = document.getElementById("sitesearch-backdrop")!;
  const input = document.getElementById("sitesearch-input") as HTMLInputElement;
  const results = document.getElementById("sitesearch-results")!;

  async function ensureData() {
    if (data) return;
    const res = await fetch("/search-index.json");
    data = await res.json();
  }

  function includes(text: string, q: string) {
    return text.toLowerCase().includes(q);
  }

  function render(query: string) {
    if (!data) return;
    const q = query.trim().toLowerCase();

    const containerMatches = q
      ? data.containers.filter((c) => includes(c.title, q))
      : data.containers;
    const pageMatches = q
      ? data.pages.filter(
          (p) =>
            includes(p.title, q) || includes(p.category, q) || p.tags.some((t) => includes(t, q))
        )
      : data.pages;

    // containers (checkpoints) rank first, guide pages after
    flat = [...containerMatches, ...pageMatches];
    activeIndex = 0;

    if (flat.length === 0) {
      results.innerHTML = `<li class="sitesearch-empty">no matches</li>`;
      return;
    }

    let html = "";
    if (containerMatches.length > 0) {
      html += `<li class="sitesearch-group-label">categories</li>`;
      containerMatches.forEach((c, i) => (html += itemHtml(c, i)));
    }
    if (pageMatches.length > 0) {
      html += `<li class="sitesearch-group-label">guides</li>`;
      pageMatches.forEach((p, i) => (html += itemHtml(p, containerMatches.length + i)));
    }
    results.innerHTML = html;

    results.querySelectorAll<HTMLElement>(".sitesearch-item").forEach((el) => {
      el.addEventListener("mouseenter", () => {
        activeIndex = Number(el.dataset.index);
        highlight();
      });
      el.addEventListener("click", () => {
        window.location.href = el.dataset.href!;
      });
    });

    highlight();
  }

  function itemHtml(entry: Container | Page, i: number) {
    const meta = entry.type === "container" ? "category" : (entry as Page).category;
    return `<li class="sitesearch-item" data-index="${i}" data-href="${entry.href}">
      <span class="sitesearch-item-title">${entry.title}</span>
      <span class="sitesearch-item-meta">${meta}</span>
    </li>`;
  }

  function highlight() {
    results.querySelectorAll<HTMLElement>(".sitesearch-item").forEach((el) => {
      el.classList.toggle("active", Number(el.dataset.index) === activeIndex);
    });
    results
      .querySelector<HTMLElement>(".sitesearch-item.active")
      ?.scrollIntoView({ block: "nearest" });
  }

  async function openSiteSearch() {
    await ensureData();
    backdrop.classList.add("open");
    input.value = "";
    render("");
    input.focus();
  }

  function closeSiteSearch() {
    backdrop.classList.remove("open");
  }

  (window as any).openSiteSearch = openSiteSearch;

  input.addEventListener("input", () => render(input.value));

  input.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown") {
      e.preventDefault();
      activeIndex = Math.min(activeIndex + 1, flat.length - 1);
      highlight();
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      activeIndex = Math.max(activeIndex - 1, 0);
      highlight();
    } else if (e.key === "Enter") {
      e.preventDefault();
      const target = flat[activeIndex];
      if (target) window.location.href = target.href;
    }
  });

  backdrop.addEventListener("click", (e) => {
    if (e.target === backdrop) closeSiteSearch();
  });

  window.addEventListener("keydown", (e: KeyboardEvent) => {
    const isOpen = backdrop.classList.contains("open");

    if (e.key === "Escape" && isOpen) {
      e.preventDefault();
      closeSiteSearch();
      return;
    }
    if (isOpen) return;

    const tag = (document.activeElement as HTMLElement)?.tagName;
    const inInput =
      tag === "INPUT" ||
      tag === "TEXTAREA" ||
      tag === "SELECT" ||
      (document.activeElement as HTMLElement)?.isContentEditable;
    if (inInput) return;

    if (e.key === "/" && !e.ctrlKey && !e.metaKey) {
      e.preventDefault();
      openSiteSearch();
    } else if (e.key === "k" && (e.ctrlKey || e.metaKey)) {
      e.preventDefault();
      openSiteSearch();
    }
  });
</script>
