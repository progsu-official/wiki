---
interface Props {
  active: "browse" | "scheduler" | "plans" | "compare";
}

const { active } = Astro.props;

const tabs = [
  { key: "browse", label: "browse", href: "/courses" },
  { key: "scheduler", label: "scheduler", href: "/courses/scheduler" },
  { key: "plans", label: "plans", href: "/courses/plans" },
  { key: "compare", label: "compare", href: "/courses/compare" },
] as const;
---

<nav class="csub" aria-label="Courses sections">
  {
    tabs.map((t) => (
      <a
        href={t.href}
        class:list={["csub__link", { "is-active": t.key === active }]}
        aria-current={t.key === active ? "page" : undefined}
      >
        {t.label}
      </a>
    ))
  }
</nav>

<style>
  .csub {
    display: flex;
    gap: var(--space-6);
    margin-bottom: var(--space-8);
    border-bottom: 1px solid var(--c-divider);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .csub::-webkit-scrollbar {
    display: none;
  }

  .csub__link {
    position: relative;
    flex-shrink: 0;
    padding: var(--space-3) 0;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--c-text-2);
    text-decoration: none;
    margin-bottom: -1px;
    transition: color var(--duration-fast) var(--ease);
  }

  /* The active indicator is a positioned bar, not a border: a border cannot
     carry the accent gradient. */
  .csub__link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    border-radius: 2px 2px 0 0;
    background: var(--grad-accent-line);
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease);
  }

  .csub__link:hover {
    color: var(--c-text-1);
  }
  .csub__link:hover::after {
    opacity: 0.35;
  }

  .csub__link.is-active {
    color: var(--c-brand-1);
    font-weight: 600;
  }
  .csub__link.is-active::after,
  .csub__link.is-active:hover::after {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .csub__link,
    .csub__link::after {
      transition: none;
    }
  }

  @media (max-width: 640px) {
    .csub {
      gap: var(--space-5);
    }
    .csub__link {
      padding: var(--space-3) var(--space-1);
      min-height: 44px;
      display: flex;
      align-items: center;
    }
  }
</style>
