---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol class="crumbs__list">
    {
      items.map((item, i) => (
        <li class="crumbs__item">
          {i > 0 && (
            <span class="crumbs__sep" aria-hidden="true">
              /
            </span>
          )}
          {item.href ? (
            <a href={item.href} class="crumbs__link">
              {item.label}
            </a>
          ) : (
            <span class="crumbs__current" aria-current="page">
              {item.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs {
    margin-bottom: var(--space-6);
  }

  .crumbs__list {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .crumbs__list::-webkit-scrollbar {
    display: none;
  }

  .crumbs__item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    white-space: nowrap;
  }

  .crumbs__sep {
    color: var(--c-text-3);
    user-select: none;
  }

  .crumbs__link {
    display: inline-block;
    padding: var(--space-1) 0;
    color: var(--c-text-2);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease);
  }

  .crumbs__link:hover {
    color: var(--c-brand-1);
  }

  .crumbs__current {
    color: var(--c-text-1);
  }
</style>
