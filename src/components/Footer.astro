---
import SocialRow from "./SocialRow.astro";

interface Props {
  /**
   * Render inside a docs content column rather than as a full-bleed band.
   * The column already constrains the width, so the container and the
   * background band both come off.
   */
  contained?: boolean;
}

const { contained = false } = Astro.props;

const year = new Date().getFullYear();
---

<footer class:list={["site-footer", { "site-footer--contained": contained }]} role="contentinfo">
  <div class:list={[{ container: !contained }]}>
    <div class="site-footer__row">
      <p class="site-footer__legal">&copy; {year} progsu &middot; built by progsu</p>
      <SocialRow />
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--c-divider);
    background: var(--c-bg-alt);
    padding-block: var(--space-8);
    margin-top: auto;
  }

  /* In a docs column the footer is not a band: it shares the article's
     measure and its ground, separated only by the rule above it. */
  .site-footer--contained {
    background: none;
    padding-block: var(--space-6) 0;
    margin-top: var(--space-16);
  }

  .site-footer__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .site-footer__legal {
    margin: 0;
    font-size: 14px;
    color: var(--c-text-2);
  }

  /* Keyed low: the contained footer sits in a 688px column, so it must not
     stack until the row genuinely runs out of room. */
  @media (max-width: 480px) {
    .site-footer__row {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-5);
    }
  }
</style>
