---
import SocialRow from "./SocialRow.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="site-footer__row">
      <p class="site-footer__legal">&copy; {year} progsu &middot; built by progsu</p>
      <SocialRow />
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--c-divider);
    background: var(--c-bg-alt);
    padding-block: var(--space-8);
    margin-top: auto;
  }

  .site-footer__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .site-footer__legal {
    margin: 0;
    font-size: 14px;
    color: var(--c-text-2);
  }

  @media (max-width: 480px) {
    .site-footer__row {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-5);
    }
  }
</style>
