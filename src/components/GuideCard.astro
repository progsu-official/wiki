---
import Badge from "./Badge.astro";

interface Props {
  title: string;
  href: string;
  readTime: string;
  authorName: string;
  tags: string[];
  badge?: string;
}

const { title, href, readTime, authorName, tags, badge } = Astro.props;
---

<a href={href} class="card card--link guide-card">
  <span class="guide-card__body">
    <span class="guide-card__title-row">
      <span class="guide-card__title">{title}</span>
      {badge && <Badge text={badge} variant="brand" />}
    </span>
    <span class="guide-card__meta">{readTime} · {authorName}</span>
    {
      tags.length > 0 && (
        <span class="guide-card__tags">
          {tags.map((tag) => (
            <Badge text={tag} />
          ))}
        </span>
      )
    }
  </span>
  <span class="guide-card__arrow" aria-hidden="true">&rarr;</span>
</a>

<style>
  /* `a.` outbids the global `.card` padding without !important. */
  a.guide-card {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 44px;
    padding: var(--space-4) var(--space-5);
  }

  .guide-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
    flex: 1;
  }

  .guide-card__title-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .guide-card__title {
    font-size: var(--text-base);
    font-weight: 600;
    line-height: var(--leading-snug);
    color: var(--c-text-1);
  }

  .guide-card__meta {
    font-size: var(--text-sm);
    color: var(--c-text-2);
  }

  .guide-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .guide-card__arrow {
    flex-shrink: 0;
    font-size: var(--text-base);
    line-height: 1;
    color: var(--c-text-3);
    transition:
      color var(--duration-normal) var(--ease),
      transform var(--duration-normal) var(--ease);
  }

  a.guide-card:hover .guide-card__arrow {
    color: var(--c-brand-1);
    transform: translateX(4px);
  }

  @media (max-width: 480px) {
    a.guide-card {
      padding: var(--space-4);
    }
  }
</style>
