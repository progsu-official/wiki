---
import Zone from "./Zone.astro";
---

<div class="overlay-backdrop" id="course-detail-overlay" style="display:none">
  <div class="overlay">
    <button class="overlay__close" type="button" aria-label="Close">&times;</button>

    <div class="overlay__layout">
      <Zone label="course title · number · credits" height="60px" />
      <Zone label="student-written description" height="100px" />
      <Zone label="prerequisite chain visualization" height="140px" />
      <Zone label="semesters offered · typical availability" height="60px" />
      <Zone label="member notes · workload · honest takes" height="160px" />
      <Zone label="add to schedule button" height="50px" />
    </div>
  </div>
</div>

<style>
  .overlay-backdrop {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    background: rgba(20, 16, 33, 0.5);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: var(--space-6);
  }

  .overlay {
    position: relative;
    width: 100%;
    max-width: 560px;
    max-height: 85vh;
    overflow-y: auto;
    background: var(--c-bg-elv);
    border: 1px solid var(--c-divider);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xl);
    padding: var(--space-8);
  }

  .overlay__close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    background: none;
    border: none;
    color: var(--c-text-3);
    font-size: var(--text-xl);
    cursor: pointer;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    transition:
      color var(--duration-fast) var(--ease),
      background-color var(--duration-fast) var(--ease);
  }
  .overlay__close:hover {
    color: var(--c-text-1);
    background: var(--c-bg-mute);
  }

  .overlay__layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  @media (max-width: 767px) {
    .overlay-backdrop {
      padding: 0;
      align-items: flex-end;
    }
    .overlay {
      max-height: 90vh;
      border-radius: var(--radius-xl) var(--radius-xl) 0 0;
      padding: var(--space-6);
      padding-bottom: calc(var(--space-6) + env(safe-area-inset-bottom, 0px));
    }
  }

  @media (min-width: 768px) {
    .overlay-backdrop {
      align-items: center;
    }
  }
</style>
