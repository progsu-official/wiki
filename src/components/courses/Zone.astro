---
interface Props {
  label: string;
  height?: string;
}

const { label, height = "120px" } = Astro.props;
---

<div class="zone" style={`min-height: ${height}`}>
  <span class="zone__label">{label}</span>
</div>

<style>
  .zone {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--c-bg-soft);
    border: 1px dashed var(--c-border);
    border-radius: var(--radius-lg);
  }

  .zone__label {
    font-size: var(--text-xs);
    color: var(--c-text-3);
    text-align: center;
    padding: var(--space-4);
  }
</style>
