---
import Zone from "./Zone.astro";
---

<div class="tray" id="schedule-tray">
  <div class="tray__bar">
    <span class="tray__title">your schedule</span>
    <span class="tray__meta">0 courses &middot; 0 credits</span>
    <a href="/courses/schedule" class="tray__expand">expand &rarr;</a>
  </div>
  <div class="tray__body" style="display:none">
    <Zone label="course pills · drag to reorder" height="60px" />
    <Zone label="conflict warnings" height="40px" />
  </div>
</div>

<style>
  .tray {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: var(--z-sticky);
    background: var(--c-bg-elv);
    border-top: 1px solid var(--c-divider);
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    box-shadow: var(--shadow-lg);
    padding: var(--space-4) var(--space-6);
    padding-bottom: calc(var(--space-4) + env(safe-area-inset-bottom, 0px));
  }

  .tray__bar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .tray__title {
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    color: var(--c-text-1);
  }

  .tray__meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--c-text-3);
  }

  .tray__expand {
    margin-left: auto;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--c-brand-1);
    text-decoration: none;
  }
  .tray__expand:hover {
    color: var(--c-brand-2);
  }

  .tray__body {
    margin-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
</style>
