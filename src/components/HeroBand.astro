---
import { Image } from "astro:assets";
import HeroGlobe from "./HeroGlobe.astro";

interface RecentGuide {
  title: string;
  category: string;
  href: string;
  updated: Date;
}

interface Topic {
  title: string;
  href: string;
  count: number;
}

interface UpcomingEvent {
  name: string;
  when: string;
  href: string;
  /** The event's own flyer or logo, cropped square for the row. */
  image: ImageMetadata;
  /** Only the first (featured) event renders this. */
  blurb?: string;
}

interface EventsCta {
  label: string;
  href: string;
  blurb?: string;
}

interface Props {
  eyebrow?: string;
  /** Rendered as HTML so the headline can carry its own <br> and accent span. */
  title: string;
  subtitle?: string;
  /** The left flank of the stage. Omitted, the column doesn't render. */
  topicsLabel?: string;
  topics?: Topic[];
  /** The right flank. Omitted, the column doesn't render. */
  eventLabel?: string;
  /** The first event in the list gets the bigger, featured treatment. */
  events?: UpcomingEvent[];
  /** Sits under the event list, pointing at the members platform. */
  eventsCta?: EventsCta;
  /** The rail along the foot of the hero. Omitted, the rail doesn't render. */
  railLabel?: string;
  recent?: RecentGuide[];
  /** Sits in the hero's bottom corner for pages that carry no site footer. */
  colophon?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  topicsLabel,
  topics = [],
  eventLabel,
  events = [],
  eventsCta,
  railLabel,
  recent = [],
  colophon,
} = Astro.props;
const hasActions = Astro.slots.has("default");
const hasTopics = topics.length > 0;
const hasEvents = events.length > 0;
const hasRail = recent.length > 0;
const isExternal = (href: string) => /^https?:\/\//.test(href);

// Frontmatter dates are UTC midnight; formatting them locally renders the
// previous day anywhere west of UTC.
const shortDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  });
---

<section class="brand-band hero">
  {
    /* The drafting sheet: two rules bounding the column, a dot field in the
      margins they leave behind, and ticks on the corners. The rules land on
      the same 1104px column the rail spans, so the marks read as one drawing
      rather than as decoration laid over the content. */
  }
  <div class="hero__bg" aria-hidden="true">
    <span class="hero__margin hero__margin--l"></span>
    <span class="hero__margin hero__margin--r"></span>

    <span class="hero__rule hero__rule--l"></span>
    <span class="hero__rule hero__rule--r"></span>

    <span class="hero__tick hero__tick--l"></span>
    <span class="hero__tick hero__tick--r"></span>
  </div>

  <div class="hero__inner container">
    {
      eyebrow && (
        <p class="hero__eyebrow">
          <span class="hero__dot" />
          {eyebrow}
        </p>
      )
    }
    <h1 class="hero__title" set:html={title} />
    {subtitle && <p class="hero__subtitle">{subtitle}</p>}
    {
      hasActions && (
        <div class="hero__actions">
          <slot />
        </div>
      )
    }
  </div>

  {
    /* The stage fills whatever height the copy leaves: the sphere in the
      middle track, and the two things a visitor most likely came for in the
      space either side of it — where to start reading, and what's on. */
  }
  <div class="hero__stage">
    {
      hasTopics && (
        <nav class="hero__topics" aria-label={topicsLabel}>
          {topicsLabel && <p class="hero__flank-label">{topicsLabel}</p>}

          <ul class="hero__topic-list" role="list">
            {topics.map((topic) => (
              <li>
                <a class="hero__topic" href={topic.href}>
                  <span class="hero__topic-name">{topic.title}</span>
                  <span class="hero__topic-count">
                    {topic.count}
                    <span class="sr-only">{topic.count === 1 ? " guide" : " guides"}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="hero__globe">
      <HeroGlobe />
    </div>

    {
      hasEvents && (
        <aside class="hero__events" aria-label={eventLabel}>
          {eventLabel && <p class="hero__flank-label">{eventLabel}</p>}

          <ul class="hero__event-list" role="list">
            {events.map((event, i) => (
              <li>
                <a
                  class:list={[
                    "hero__event",
                    { "hero__event--featured": i === 0, "hero__event--last": i === events.length - 1 },
                  ]}
                  href={event.href}
                  {...(isExternal(event.href) ? { target: "_blank", rel: "noopener" } : {})}
                >
                  {i === 0 && <span class="hero__event-featured-tag">biggest event</span>}

                  {/* The row's own text names the link, so alt would only say
                      it twice to a screen reader. */}
                  <Image class="hero__event-art" src={event.image} alt="" width={320} />

                  <span class="hero__event-text">
                    <span class="hero__event-name-row">
                      <span class="hero__event-name">{event.name}</span>
                      {isExternal(event.href) && (
                        <svg
                          class="hero__event-out"
                          width="11"
                          height="11"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="M7 17 17 7" />
                          <path d="M8 7h9v9" />
                        </svg>
                      )}
                    </span>
                    <span class="hero__event-when">{event.when}</span>
                    {event.blurb && <span class="hero__event-blurb">{event.blurb}</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>

          {
            eventsCta && (
              <div class="hero__events-cta">
                {eventsCta.blurb && <p class="hero__events-cta-blurb">{eventsCta.blurb}</p>}
                {/* Same-tab on purpose: this is the one link in the flank meant
                    to actually take you off the wiki, not just cite a source. */}
                <a class="btn btn--brand btn--sm" href={eventsCta.href}>
                  {eventsCta.label}
                </a>
              </div>
            )
          }
        </aside>
      )
    }
  </div>

  {
    hasRail && (
      <nav class="hero__rail" aria-label={railLabel}>
        <span class="hero__tick hero__tick--l" aria-hidden="true" />
        <span class="hero__tick hero__tick--r" aria-hidden="true" />

        <div class="container">
          {railLabel && <p class="hero__rail-label">{railLabel}</p>}

          {/* list-style: none drops list semantics in Safari, and how many
              guides are on offer is part of what the strip is saying. */}
          <ul class="hero__recent" role="list" style={`--count:${recent.length}`}>
            {recent.map((guide) => (
              <li>
                <a class="hero__recent-link" href={guide.href}>
                  <span class="hero__recent-meta">
                    <span>{guide.category}</span>
                    <time datetime={guide.updated.toISOString()}>{shortDate(guide.updated)}</time>
                  </span>
                  <span class="hero__recent-title">{guide.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </nav>
    )
  }

  {colophon && <p class="hero__colophon">{colophon}</p>}
</section>

<style>
  .hero {
    /* A fixed dark slab in both themes, so the marks and the globe keep one
       set of values. The greys are the dark theme's own --c-bg-alt/--c-bg-soft,
       pinned here because the hero must not flip with the page. */
    --hero-ground: #101012;
    --hero-lift: #1c1c20;
    --hero-mark: rgba(255, 255, 255, 0.14);
    /* Quieter than the sheet's own marks: the topic rules divide a list, they
       aren't part of the drawing. */
    --hero-hair: rgba(255, 255, 255, 0.09);

    /* The accent the eyebrow dot and the headline already carry, named so the
       event dates can pick it up without a third copy of the hex. */
    --hero-accent: #c084fc;

    /* The column the rules bound — the same width the rail spans, so the
       rail's hairline ends exactly on them. */
    --hero-column: min(var(--page-width-wide), 100% - var(--space-6) * 2);
    --hero-edge: calc((100% - var(--hero-column)) / 2);

    /* .brand-band pins this to the retired gradient's darkest stop. */
    --focus-ring: 0 0 0 2px var(--hero-ground), 0 0 0 4px rgba(255, 255, 255, 0.9);

    position: relative;
    display: flex;
    flex-direction: column;
    /* svh so mobile browser chrome can't push the rail out of view. */
    min-height: calc(100vh - var(--nav-height));
    min-height: calc(100svh - var(--nav-height));
    overflow: hidden;
    padding-block: var(--space-10) var(--space-8);
    background:
      radial-gradient(ellipse 90% 70% at 50% -8%, var(--hero-lift), transparent 70%),
      var(--hero-ground);
    background-color: var(--hero-ground);
  }

  /* ── The sheet ── */

  .hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* Plain black margins outside the rules — no dot texture: past 1600px the
     topics/events flanks sit directly on top of this space (below), and any
     dot pattern there either shows through as noise behind their text or,
     at this ground colour, is too faint to read as anything but a dead
     black band. */
  .hero__margin {
    position: absolute;
    top: 0;
    bottom: 0;
    width: var(--hero-edge);
  }
  .hero__margin--l {
    left: 0;
  }
  .hero__margin--r {
    right: 0;
  }

  .hero__rule {
    position: absolute;
    top: 0;
    bottom: 0;
    border-left: 1px dashed var(--hero-mark);
  }
  .hero__rule--l {
    left: var(--hero-edge);
  }
  .hero__rule--r {
    right: var(--hero-edge);
  }

  /* A registration mark on each corner of the block the rules bound: the top
     pair sits under the navbar, the bottom pair on the rail's dashed rule. */
  .hero__tick {
    position: absolute;
    top: 0;
    width: 11px;
    height: 11px;
    margin: -5px 0 0 -5px;
    background-image: linear-gradient(var(--hero-mark) 0 0), linear-gradient(var(--hero-mark) 0 0);
    background-size:
      11px 1px,
      1px 11px;
    background-position: center;
    background-repeat: no-repeat;
  }
  .hero__tick--l {
    left: var(--hero-edge);
  }
  .hero__tick--r {
    right: var(--hero-edge);
    margin-right: -5px;
    margin-left: 0;
  }

  /* ── Content ── */

  /* The copy is only as tall as it needs to be; the stage below it takes the
     rest, so the sphere grows into whatever height is going spare. */
  .hero__inner {
    position: relative;
    z-index: 1;
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-5);
    padding: 6px 14px 6px 12px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.07);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: var(--tracking-normal);
    color: var(--c-text-inverse-2);
    animation: hero-rise 700ms var(--ease-out) both;
  }

  .hero__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--hero-accent);
  }

  .hero .hero__title {
    margin: 0;
    font-size: var(--text-6xl);
    font-weight: 700;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--c-text-inverse-1);
    animation: hero-rise 700ms var(--ease-out) 80ms both;
  }

  /* Set via set:html from the page, so it sits outside this file's scoping. */
  .hero__title :global(.hero__accent) {
    color: var(--hero-accent);
  }

  .hero .hero__subtitle {
    margin: var(--space-5) 0 0;
    max-width: 46ch;
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    color: var(--c-text-inverse-2);
    animation: hero-rise 700ms var(--ease-out) 160ms both;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-6);
    animation: hero-rise 700ms var(--ease-out) 240ms both;
  }

  /* ── The stage ──
     Three tracks under the copy. The flanks are fixed so the sphere gets
     whatever is left, and they hang from the top of the stage rather than
     centring in it — they read as columns of a page, not as floating panels. */

  /* Narrow enough and the margins are a sliver, so the flanks tuck inside the
     rules and share the column with the sphere. The wide case below moves them
     out onto the dot field where there's room for them. */
  .hero__stage {
    position: relative;
    z-index: 1;
    flex: 1;
    min-height: 0;
    width: 100%;
    max-width: var(--page-width-wide);
    margin-top: var(--space-8);
    margin-inline: auto;
    padding-inline: var(--space-6);
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr) 15rem;
    gap: var(--space-8);
    text-align: left;
  }

  .hero .hero__flank-label {
    margin: 0 0 var(--space-4);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: lowercase;
    color: var(--c-text-inverse-3);
  }

  /* The sphere is bigger than the space left for it. It's anchored to the top
     of this box and clipped at the bottom, so the world runs on past the rule
     rather than sitting in the hero like an illustration. */
  .hero__globe {
    position: relative;
    min-height: 0;
    overflow: hidden;
    /* 100% is the middle track, so the sphere fits between the flanks instead
       of being sized off the viewport as it was when it had the row alone. */
    --globe-size: min(100%, 62vh, 600px);
    animation: hero-rise 900ms var(--ease-out) 320ms both;
  }

  .hero__globe > :global(.globe) {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
  }

  /* ── Topics ──
     A table of contents, not a set of cards: name, count, hairline. Whatever
     brought a visitor here, the whole wiki is one glance away. */

  .hero__topics {
    animation: hero-rise 700ms var(--ease-out) 400ms both;
  }

  .hero__topic-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--hero-hair);
    list-style: none;
  }

  .hero .hero__topic {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--hero-hair);
    text-decoration: none;
    transition: color var(--duration-normal) var(--ease);
  }

  /* The row nudges rather than growing an arrow: the count already owns the
     right edge, and there's nowhere for a marker to go that doesn't shove it. */
  .hero__topic-name {
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--c-text-inverse-2);
    transition:
      color var(--duration-normal) var(--ease),
      transform var(--duration-normal) var(--ease);
  }

  .hero__topic-count {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--c-text-inverse-3);
    transition: color var(--duration-normal) var(--ease);
  }

  .hero__topic:hover .hero__topic-name,
  .hero__topic:focus-visible .hero__topic-name {
    color: var(--c-text-inverse-1);
    transform: translateX(2px);
  }

  .hero__topic:hover .hero__topic-count,
  .hero__topic:focus-visible .hero__topic-count {
    color: var(--c-text-inverse-2);
  }

  .hero__topic:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-md);
  }

  /* ── What's on ──
     The topics flank's twin: the same hairlines and the same quiet brightening,
     so the two margins read as a pair of columns rather than a list facing a
     card. Each row carries the event's own flyer. */

  .hero__events {
    animation: hero-rise 700ms var(--ease-out) 440ms both;
  }

  .hero__event-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--hero-hair);
    list-style: none;
  }

  /* Every event gets the same banner card: a full-width poster over the
     text, not a small logo tile in a row — the whole flank reads as a
     stack of posters rather than a list. */
  .hero .hero__event {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4) 0;
    border-bottom: 1px dashed var(--hero-mark);
    text-decoration: none;
  }

  /* Last in the list sits right above the CTA, which already reads as its
     own block below — a second rule there just doubles the one above it. */
  .hero .hero__event--last {
    border-bottom: none;
    padding-bottom: 0;
  }

  /* Wide, not square: full width, shorter than the featured poster below. */
  .hero__event-art {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    object-fit: cover;
    object-position: center;
  }

  /* The source flyer is a square lockup (rainbow arcs + wordmark) — matching
     the tile's aspect ratio to it means every crop shows the whole design
     instead of slicing through the text. */
  .hero__event--featured .hero__event-art {
    aspect-ratio: 1;
  }

  .hero__event--featured .hero__event-name {
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .hero .hero__event-blurb {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--c-text-inverse-3);
  }

  .hero__event-featured-tag {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--hero-accent);
  }

  .hero__events-cta {
    margin-top: var(--space-6);
  }

  .hero .hero__events-cta-blurb {
    margin: 0 0 var(--space-3);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--c-text-inverse-3);
  }

  .hero__event-text {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: var(--space-1);
  }

  .hero .hero__event-name {
    font-size: var(--text-base);
    font-weight: 500;
    line-height: var(--leading-snug);
    color: var(--c-text-inverse-2);
    transition: color var(--duration-normal) var(--ease);
  }

  /* The one thing in the hero that is time-sensitive, so it's the one thing
     that carries the accent rather than the sheet's neutral greys. */
  .hero .hero__event-when {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
    color: var(--hero-accent);
  }

  /* Where the topic rows keep their count. Every event so far lives on another
     site, and the row shouldn't have to be clicked to find that out. */
  /* On the title's own line, not trailing the whole card — a card this
     tall left it floating alone above the divider with nothing to anchor
     it to. */
  .hero__event-name-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    width: 100%;
  }

  .hero__event-out {
    flex-shrink: 0;
    color: var(--c-text-inverse-3);
    transition: color var(--duration-normal) var(--ease);
  }

  .hero__event:hover .hero__event-name,
  .hero__event:focus-visible .hero__event-name {
    color: var(--c-text-inverse-1);
  }

  .hero__event:hover .hero__event-out,
  .hero__event:focus-visible .hero__event-out {
    color: var(--c-text-inverse-2);
  }

  .hero__event:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-md);
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ── The rail ──
     The three most recently touched guides, one per category. It anchors the
     foot of a full-height hero, and it shows a first-time visitor that the
     wiki is both alive and wider than whatever brought them here. */

  .hero__rail {
    position: relative;
    z-index: 1;
    padding-top: var(--space-6);
    border-top: 1px dashed var(--hero-mark);
    animation: hero-rise 700ms var(--ease-out) 500ms both;
  }

  .hero .hero__rail-label {
    max-width: var(--page-width-wide);
    margin: 0 auto var(--space-5);
    padding-inline: var(--space-6);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: lowercase;
    color: var(--c-text-inverse-3);
  }

  .hero__recent {
    display: grid;
    grid-template-columns: repeat(var(--count, 3), minmax(0, 1fr));
    gap: var(--space-6);
    margin: 0 auto;
    /* The rules land on this block's outer edge; the gutter keeps the text
       off them. */
    padding-inline: var(--space-6);
    max-width: var(--page-width-wide);
    list-style: none;
  }

  /* Titles are left-aligned rather than centred under the hero: they run to
     two lines at this measure, and centred ragged wrapping reads as an
     accident. Flush left they behave like the index this strip is. */
  .hero .hero__recent-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    text-decoration: none;
    transition: color var(--duration-normal) var(--ease);
  }

  .hero__recent-title {
    font-size: var(--text-base);
    font-weight: 500;
    line-height: var(--leading-normal);
    color: var(--c-text-inverse-2);
    transition: color var(--duration-normal) var(--ease);
  }

  /* Category and date read as one quiet line above the title, the way the
     eyebrow separates its halves. */
  .hero__recent-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--text-sm);
    text-transform: lowercase;
    color: var(--c-text-inverse-3);
  }

  .hero__recent-meta time::before {
    content: "·";
    margin-right: var(--space-2);
  }

  .hero__recent-link:hover .hero__recent-title,
  .hero__recent-link:focus-visible .hero__recent-title {
    color: var(--c-text-inverse-1);
  }

  .hero__recent-link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-md);
  }

  /* ── Colophon ──
     The homepage carries no site footer, so the copyright it would have held
     tucks into the hero instead. Narrow, that's a quiet line under the rail. */

  .hero .hero__colophon {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--page-width-wide);
    margin: var(--space-6) auto 0;
    padding-inline: var(--space-6);
    font-size: var(--text-sm);
    color: var(--c-text-inverse-3);
