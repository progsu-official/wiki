---
interface Waypoint {
  label: string;
  href: string;
}

interface Props {
  eyebrow?: string;
  /** Rendered as HTML so the headline can carry its own <br> and accent span. */
  title: string;
  subtitle?: string;
  /** The rail along the foot of the hero. Omitted, the rail doesn't render. */
  railLabel?: string;
  waypoints?: Waypoint[];
}

const { eyebrow, title, subtitle, railLabel, waypoints = [] } = Astro.props;
const hasActions = Astro.slots.has("default");
const hasMeta = Astro.slots.has("meta");
const hasRail = waypoints.length > 0;
---

<section class="brand-band hero">
  <div class="hero__bg" aria-hidden="true">
    <span class="hero__aurora hero__aurora--1"></span>
    <span class="hero__aurora hero__aurora--2"></span>

    {
      /* Texture, not motion: the routes hold the empty thirds while the rail
        below keeps the page's one travelling light to itself. */
    }
    <svg class="hero__routes" viewBox="0 0 1200 600" preserveAspectRatio="xMidYMid slice">
      <path class="hero__line" d="M-60 500 C 180 500 260 384 470 372 S 800 296 1260 186"></path>
      <path class="hero__line" d="M-60 140 C 220 140 300 252 560 268 S 900 344 1260 436"></path>
      <path class="hero__line" d="M-60 300 C 260 300 400 212 640 202 S 980 250 1260 300"></path>
    </svg>

    <span class="hero__veil"></span>
  </div>

  <div class="hero__inner container">
    {
      eyebrow && (
        <p class="hero__eyebrow">
          <span class="hero__dot" aria-hidden="true" />
          {eyebrow}
        </p>
      )
    }
    <h1 class="hero__title" set:html={title} />
    {subtitle && <p class="hero__subtitle">{subtitle}</p>}
    {
      hasActions && (
        <div class="hero__actions">
          <slot />
        </div>
      )
    }
    {
      hasMeta && (
        <p class="hero__meta">
          <slot name="meta" />
        </p>
      )
    }
  </div>

  {
    hasRail && (
      <nav class="hero__rail" aria-label={railLabel}>
        <div class="container">
          {railLabel && <p class="hero__rail-label">{railLabel}</p>}

          {/* list-style: none drops list semantics in Safari, and the count
              and the order are the point here. */}
          <ol class="hero__years" role="list" style={`--count:${waypoints.length}`}>
            <span class="hero__track" aria-hidden="true" />
            {waypoints.map((point) => (
              <li>
                <a class="hero__year" href={point.href}>
                  <span class="hero__node" aria-hidden="true" />
                  {point.label}
                </a>
              </li>
            ))}
          </ol>
        </div>
      </nav>
    )
  }
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    /* svh so mobile browser chrome can't push the rail out of view. */
    min-height: calc(100vh - var(--nav-height));
    min-height: calc(100svh - var(--nav-height));
    overflow: hidden;
    padding-block: var(--space-16) var(--space-12);
  }

  /* ── Moving ground ── */

  .hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero__aurora {
    position: absolute;
    border-radius: 50%;
    will-change: transform;
  }
  .hero__aurora--1 {
    top: -30%;
    left: -14%;
    width: min(72vw, 980px);
    aspect-ratio: 1;
    background: radial-gradient(circle, rgba(124, 58, 237, 0.5), rgba(124, 58, 237, 0) 68%);
    animation: hero-drift-1 26s ease-in-out infinite alternate;
  }
  .hero__aurora--2 {
    right: -16%;
    bottom: -26%;
    width: min(78vw, 1060px);
    aspect-ratio: 1;
    background: radial-gradient(circle, rgba(168, 85, 247, 0.36), rgba(168, 85, 247, 0) 66%);
    animation: hero-drift-2 34s ease-in-out infinite alternate;
  }

  .hero__routes {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    /* Faded off at both ends: clear of the navbar above, and clear of the rail
       below so the two line systems never read as one broken line. */
    mask-image: linear-gradient(to bottom, transparent 2%, #000 20%, #000 58%, transparent 82%);
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 2%,
      #000 20%,
      #000 58%,
      transparent 82%
    );
  }

  .hero__line {
    stroke: rgba(216, 180, 254, 0.16);
    stroke-width: 1.25;
  }

  @keyframes hero-drift-1 {
    to {
      transform: translate3d(90px, 60px, 0) scale(1.12);
    }
  }
  @keyframes hero-drift-2 {
    to {
      transform: translate3d(-110px, -50px, 0) scale(1.08);
    }
  }

  /* Darkens the middle so the headline never competes with the artwork. */
  .hero__veil {
    position: absolute;
    inset: 0;
    background: radial-gradient(58% 46% at 50% 42%, rgba(20, 16, 33, 0.66), transparent 72%);
  }

  /* ── Content ── */

  .hero__inner {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .hero .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-5);
    padding: 6px 14px 6px 12px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.07);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: var(--tracking-normal);
    color: var(--c-text-inverse-2);
    animation: hero-rise 700ms var(--ease-out) both;
  }

  .hero__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #d8b4fe;
    box-shadow: 0 0 0 0 rgba(216, 180, 254, 0.55);
    animation: hero-ping 2.6s ease-out infinite;
  }

  @keyframes hero-ping {
    0% {
      box-shadow: 0 0 0 0 rgba(216, 180, 254, 0.5);
    }
    70%,
    100% {
      box-shadow: 0 0 0 9px rgba(216, 180, 254, 0);
    }
  }

  .hero .hero__title {
    margin: 0;
    font-size: var(--text-6xl);
    font-weight: 700;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--c-text-inverse-1);
    animation: hero-rise 700ms var(--ease-out) 80ms both;
  }

  /* Set via set:html from the page, so it sits outside this file's scoping. */
  .hero__title :global(.hero__accent) {
    background: linear-gradient(
      100deg,
      #d8b4fe 12%,
      #c084fc 32%,
      #f5d0fe 50%,
      #c084fc 68%,
      #d8b4fe 88%
    );
    background-size: 240% 100%;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: hero-sheen 8s linear infinite;
  }

  @keyframes hero-sheen {
    to {
      background-position: -240% 0;
    }
  }

  .hero .hero__subtitle {
    margin: var(--space-5) 0 0;
    max-width: 46ch;
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    color: var(--c-text-inverse-2);
    animation: hero-rise 700ms var(--ease-out) 160ms both;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-8);
    animation: hero-rise 700ms var(--ease-out) 240ms both;
  }

  .hero .hero__meta {
    margin: var(--space-6) 0 0;
    font-size: var(--text-sm);
    color: var(--c-text-inverse-3);
    animation: hero-rise 700ms var(--ease-out) 320ms both;
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ── The rail ──
     Four years, in order, sitting on one line. It anchors the foot of a
     full-height hero with the only sequence the wiki actually has, and it
     tells a first-year that the path is longer than one summer. */

  .hero__rail {
    position: relative;
    z-index: 1;
    animation: hero-rise 700ms var(--ease-out) 420ms both;
  }

  .hero .hero__rail-label {
    margin: 0 0 var(--space-6);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: lowercase;
    color: var(--c-text-inverse-3);
    text-align: center;
  }

  .hero__years {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--count, 4), minmax(0, 1fr));
    margin: 0 auto;
    padding: 0;
    max-width: var(--page-width-wide);
    list-style: none;
  }

  /* The hairline the nodes sit on, faded out before it reaches either end so
     the path reads as continuing past the screen. The box is 120px tall and
     pulled back up over its own centre: the hairline is one layer sized to
     100% x 1px, and the height is headroom the travelling glow needs — at 1px
     it would be clipped to a bright dash. */
  .hero__track {
    position: absolute;
    top: 4px;
    left: 0;
    right: 0;
    height: 120px;
    margin-top: -60px;
    pointer-events: none;
    background-image:
      radial-gradient(
        closest-side,
        rgba(240, 219, 255, 0.5),
        rgba(216, 180, 254, 0.12) 45%,
        rgba(216, 180, 254, 0) 100%
      ),
      linear-gradient(
        90deg,
        rgba(216, 180, 254, 0) 0%,
        rgba(216, 180, 254, 0.24) 12%,
        rgba(216, 180, 254, 0.24) 88%,
        rgba(216, 180, 254, 0) 100%
      );
    background-repeat: no-repeat;
    background-size:
      240px 120px,
      100% 1px;
    background-position:
      -240px center,
      0 center;
    /* One travelling light, no dwell: it re-enters on the left at the instant
       it clears the right, so the loop point never reads as a stop. */
    animation: hero-travel 13s linear infinite;
  }

  @keyframes hero-travel {
    to {
      background-position:
        calc(100% + 240px) center,
        0 center;
    }
  }

  .hero__year {
    display: flex;
    width: max-content;
    margin-inline: auto;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    padding-bottom: var(--space-1);
    font-size: var(--text-sm);
    color: var(--c-text-inverse-2);
    text-decoration: none;
    transition: color var(--duration-normal) var(--ease);
  }

  .hero__node {
    position: relative;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(216, 180, 254, 0.5);
    box-shadow: 0 0 0 4px rgba(216, 180, 254, 0.08);
    transition:
      background var(--duration-normal) var(--ease),
      box-shadow var(--duration-normal) var(--ease);
  }

  .hero__year:hover,
  .hero__year:focus-visible {
    color: var(--c-text-inverse-1);
  }

  .hero__year:hover .hero__node,
  .hero__year:focus-visible .hero__node {
    background: #f0dbff;
    box-shadow: 0 0 0 6px rgba(216, 180, 254, 0.18);
  }

  .hero__year:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-md);
  }

  @media (max-width: 768px) {
    .hero {
      padding-block: var(--space-12) var(--space-8);
    }

    /* The headline's own <br> is set for the wide measure. */
    .hero__title :global(br) {
      display: none;
    }

    .hero__veil {
      background: radial-gradient(90% 44% at 50% 42%, rgba(20, 16, 33, 0.7), transparent 78%);
    }

    /* Four columns of 9px text is unreadable; the rail folds to two rows and
       the hairline steps aside rather than cutting between them. */
    .hero__years {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
    }

    .hero__track {
      display: none;
    }
  }

  @media (max-width: 640px) {
    /* .hero__inner centres its children, so the row has to claim the width
       before a full-bleed button inside it can take it. */
    .hero__actions {
      align-self: stretch;
    }
  }

  /* Ambient motion is decoration; pin every layer to a good static frame. */
  @media (prefers-reduced-motion: reduce) {
    .hero__aurora--1,
    .hero__aurora--2,
    .hero__dot,
    .hero__title :global(.hero__accent) {
      animation: none;
    }

    .hero__track {
      animation: none;
      background-position:
        62% center,
        0 center;
    }
  }
</style>
