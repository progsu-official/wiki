---
import HeroGlobe from "./HeroGlobe.astro";

interface RecentGuide {
  title: string;
  category: string;
  href: string;
}

interface Props {
  eyebrow?: string;
  /** Rendered as HTML so the headline can carry its own <br> and accent span. */
  title: string;
  subtitle?: string;
  /** The rail along the foot of the hero. Omitted, the rail doesn't render. */
  railLabel?: string;
  recent?: RecentGuide[];
}

const { eyebrow, title, subtitle, railLabel, recent = [] } = Astro.props;
const hasActions = Astro.slots.has("default");
const hasMeta = Astro.slots.has("meta");
const hasRail = recent.length > 0;
---

<section class="brand-band hero">
  {
    /* The drafting sheet: two rules bounding the column, a dot field in the
      margins they leave behind, and ticks on the corners. The rules land on
      the same 1104px column the rail spans, so the marks read as one drawing
      rather than as decoration laid over the content. */
  }
  <div class="hero__bg" aria-hidden="true">
    <span class="hero__margin hero__margin--l"></span>
    <span class="hero__margin hero__margin--r"></span>

    <span class="hero__rule hero__rule--l"></span>
    <span class="hero__rule hero__rule--r"></span>

    <span class="hero__tick hero__tick--l"></span>
    <span class="hero__tick hero__tick--r"></span>
  </div>

  <div class="hero__inner container">
    {
      eyebrow && (
        <p class="hero__eyebrow">
          <span class="hero__dot" />
          {eyebrow}
        </p>
      )
    }
    <h1 class="hero__title" set:html={title} />
    {subtitle && <p class="hero__subtitle">{subtitle}</p>}
    {
      hasActions && (
        <div class="hero__actions">
          <slot />
        </div>
      )
    }
    {
      hasMeta && (
        <p class="hero__meta">
          <slot name="meta" />
        </p>
      )
    }

    <div class="hero__globe">
      <HeroGlobe />
    </div>
  </div>

  {
    hasRail && (
      <nav class="hero__rail" aria-label={railLabel}>
        <span class="hero__tick hero__tick--l" aria-hidden="true" />
        <span class="hero__tick hero__tick--r" aria-hidden="true" />

        <div class="container">
          {railLabel && <p class="hero__rail-label">{railLabel}</p>}

          {/* list-style: none drops list semantics in Safari, and how many
              guides are on offer is part of what the strip is saying. */}
          <ul class="hero__recent" role="list" style={`--count:${recent.length}`}>
            {recent.map((guide) => (
              <li>
                <a class="hero__recent-link" href={guide.href}>
                  <span class="hero__recent-category">{guide.category}</span>
                  <span class="hero__recent-title">{guide.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </nav>
    )
  }
</section>

<style>
  .hero {
    /* A fixed dark slab in both themes, so the marks and the globe keep one
       set of values. The greys are the dark theme's own --c-bg-alt/--c-bg-soft,
       pinned here because the hero must not flip with the page. */
    --hero-ground: #101012;
    --hero-lift: #1c1c20;
    --hero-mark: rgba(255, 255, 255, 0.14);
    --hero-dot: rgba(255, 255, 255, 0.055);

    /* The column the rules bound — the same width the rail spans, so the
       rail's hairline ends exactly on them. */
    --hero-column: min(var(--page-width-wide), 100% - var(--space-6) * 2);
    --hero-edge: calc((100% - var(--hero-column)) / 2);

    /* .brand-band pins this to the retired gradient's darkest stop. */
    --focus-ring: 0 0 0 2px var(--hero-ground), 0 0 0 4px rgba(255, 255, 255, 0.9);

    position: relative;
    display: flex;
    flex-direction: column;
    /* svh so mobile browser chrome can't push the rail out of view. */
    min-height: calc(100vh - var(--nav-height));
    min-height: calc(100svh - var(--nav-height));
    overflow: hidden;
    padding-block: var(--space-10) var(--space-8);
    background:
      radial-gradient(ellipse 90% 70% at 50% -8%, var(--hero-lift), transparent 70%),
      var(--hero-ground);
    background-color: var(--hero-ground);
  }

  /* ── The sheet ── */

  .hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* Dots live outside the rules only: the reading column stays clean and the
     texture reads as the sheet the drawing sits on. */
  .hero__margin {
    position: absolute;
    top: 0;
    bottom: 0;
    width: var(--hero-edge);
    background-image: radial-gradient(var(--hero-dot) 1px, transparent 1px);
    background-size: 24px 24px;
  }
  .hero__margin--l {
    left: 0;
  }
  .hero__margin--r {
    right: 0;
  }

  .hero__rule {
    position: absolute;
    top: 0;
    bottom: 0;
    border-left: 1px dashed var(--hero-mark);
  }
  .hero__rule--l {
    left: var(--hero-edge);
  }
  .hero__rule--r {
    right: var(--hero-edge);
  }

  /* A registration mark on each corner of the block the rules bound: the top
     pair sits under the navbar, the bottom pair on the rail's dashed rule. */
  .hero__tick {
    position: absolute;
    top: 0;
    width: 11px;
    height: 11px;
    margin: -5px 0 0 -5px;
    background-image: linear-gradient(var(--hero-mark) 0 0), linear-gradient(var(--hero-mark) 0 0);
    background-size:
      11px 1px,
      1px 11px;
    background-position: center;
    background-repeat: no-repeat;
  }
  .hero__tick--l {
    left: var(--hero-edge);
  }
  .hero__tick--r {
    right: var(--hero-edge);
    margin-right: -5px;
    margin-left: 0;
  }

  /* ── Content ── */

  .hero__inner {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-5);
    padding: 6px 14px 6px 12px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.07);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: var(--tracking-normal);
    color: var(--c-text-inverse-2);
    animation: hero-rise 700ms var(--ease-out) both;
  }

  .hero__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #c084fc;
  }

  .hero .hero__title {
    margin: 0;
    font-size: var(--text-6xl);
    font-weight: 700;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--c-text-inverse-1);
    animation: hero-rise 700ms var(--ease-out) 80ms both;
  }

  /* Set via set:html from the page, so it sits outside this file's scoping. */
  .hero__title :global(.hero__accent) {
    color: #c084fc;
  }

  .hero .hero__subtitle {
    margin: var(--space-5) 0 0;
    max-width: 46ch;
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    color: var(--c-text-inverse-2);
    animation: hero-rise 700ms var(--ease-out) 160ms both;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-6);
    animation: hero-rise 700ms var(--ease-out) 240ms both;
  }

  .hero .hero__meta {
    margin: var(--space-5) 0 0;
    font-size: var(--text-sm);
    color: var(--c-text-inverse-3);
    animation: hero-rise 700ms var(--ease-out) 320ms both;
  }

  /* The sphere is bigger than the space left for it. It's anchored to the top
     of this box and clipped at the bottom, so the world runs on past the rule
     rather than sitting in the hero like an illustration. */
  .hero__globe {
    position: relative;
    flex: 1;
    align-self: stretch;
    min-height: 0;
    margin-top: var(--space-6);
    overflow: hidden;
    animation: hero-rise 900ms var(--ease-out) 420ms both;
  }

  .hero__globe > :global(.globe) {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ── The rail ──
     The three most recently touched guides, one per category. It anchors the
     foot of a full-height hero, and it shows a first-time visitor that the
     wiki is both alive and wider than whatever brought them here. */

  .hero__rail {
    position: relative;
    z-index: 1;
    padding-top: var(--space-6);
    border-top: 1px dashed var(--hero-mark);
    animation: hero-rise 700ms var(--ease-out) 500ms both;
  }

  .hero .hero__rail-label {
    max-width: var(--page-width-wide);
    margin: 0 auto var(--space-5);
    padding-inline: var(--space-6);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: lowercase;
    color: var(--c-text-inverse-3);
  }

  .hero__recent {
    display: grid;
    grid-template-columns: repeat(var(--count, 3), minmax(0, 1fr));
    gap: var(--space-6);
    margin: 0 auto;
    /* The rules land on this block's outer edge; the gutter keeps the text
       off them. */
    padding-inline: var(--space-6);
    max-width: var(--page-width-wide);
    list-style: none;
  }

  /* Titles are left-aligned rather than centred under the hero: they run to
     two lines at this measure, and centred ragged wrapping reads as an
     accident. Flush left they behave like the index this strip is. */
  .hero .hero__recent-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    text-decoration: none;
    transition: color var(--duration-normal) var(--ease);
  }

  .hero__recent-title {
    font-size: var(--text-base);
    font-weight: 500;
    line-height: var(--leading-normal);
    color: var(--c-text-inverse-2);
    transition: color var(--duration-normal) var(--ease);
  }

  .hero__recent-category {
    font-size: var(--text-sm);
    color: var(--c-text-inverse-3);
  }

  .hero__recent-link:hover .hero__recent-title,
  .hero__recent-link:focus-visible .hero__recent-title {
    color: var(--c-text-inverse-1);
  }

  .hero__recent-link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-md);
  }

  /* Below the wide column the margins are a sliver — too thin to read as a
     dot field, so the sheet keeps only its rules and ticks. */
  @media (max-width: 1152px) {
    .hero__margin {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding-block: var(--space-12) var(--space-8);
    }

    /* The headline's own <br> is set for the wide measure. */
    .hero__title :global(br) {
      display: none;
    }

    /* A three-line headline and a folded rail leave the sphere about 90px of a
       100svh hero — a smudge rather than a globe. Better nothing: the rules and
       ticks still carry the sheet. With it gone the copy has no counterweight,
       so it centres in the space instead of hanging from the top. */
    .hero__globe {
      display: none;
    }

    .hero__inner {
      justify-content: center;
    }

    /* Three columns leaves each title about 20 characters a line. The strip
       stacks instead, which also keeps every row a comfortable tap target. */
    .hero__recent {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }

  @media (max-width: 640px) {
    /* .hero__inner centres its children, so the row has to claim the width
       before a full-bleed button inside it can take it. */
    .hero__actions {
      align-self: stretch;
    }
  }

  /* The globe is the hero's only ambient motion; the entrances are the site's
     ordinary arrival and stop on their own. */
  @media (prefers-reduced-motion: reduce) {
    .hero__eyebrow,
    .hero__title,
    .hero__subtitle,
    .hero__actions,
    .hero__meta,
    .hero__globe,
    .hero__rail {
      animation: none;
    }
  }
</style>
