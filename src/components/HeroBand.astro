---
interface Props {
  eyebrow?: string;
  /** Rendered as HTML so the headline can carry its own <br>. */
  title: string;
  subtitle?: string;
}

const { eyebrow, title, subtitle } = Astro.props;
const hasActions = Astro.slots.has("default");
---

<section class="brand-band hero">
  <div class="hero__inner container">
    {eyebrow && <p class="hero__eyebrow">{eyebrow}</p>}
    <h1 class="hero__title" set:html={title} />
    {subtitle && <p class="hero__subtitle">{subtitle}</p>}
    {
      hasActions && (
        <div class="hero__actions">
          <slot />
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-24);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero .hero__eyebrow {
    margin: 0 0 var(--space-4);
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: var(--tracking-normal);
    color: var(--c-text-inverse-3);
  }

  .hero .hero__title {
    margin: 0;
    font-size: var(--text-6xl);
    font-weight: 700;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--c-text-inverse-1);
  }

  .hero .hero__subtitle {
    margin: var(--space-5) 0 0;
    max-width: 46ch;
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    color: var(--c-text-inverse-2);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  @media (max-width: 768px) {
    .hero {
      padding-block: var(--space-16);
    }
  }
</style>
