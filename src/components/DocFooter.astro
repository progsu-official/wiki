---
import type { NavItem } from "../lib/guideNav";

interface Props {
  prev?: NavItem | null;
  next?: NavItem | null;
  editUrl?: string;
  updated?: Date;
}

const { prev = null, next = null, editUrl, updated } = Astro.props;

const updatedLabel = updated
  ? updated.toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
      // Frontmatter dates are UTC midnight; formatting them locally
      // renders the previous day anywhere west of UTC.
      timeZone: "UTC",
    })
  : null;
---

{
  (editUrl || updatedLabel) && (
    <div class="docfoot__meta">
      {editUrl && (
        <a class="docfoot__edit" href={editUrl} target="_blank" rel="noopener">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
            <path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4Z" />
          </svg>
          edit this page on github
        </a>
      )}
      {updatedLabel && (
        <p class="docfoot__updated">
          last updated <time datetime={updated!.toISOString()}>{updatedLabel}</time>
        </p>
      )}
    </div>
  )
}

{
  (prev || next) && (
    <nav class="docfoot__nav" aria-label="Guide">
      <div class="docfoot__slot">
        {prev && (
          <a class="docfoot__link" href={prev.link}>
            <span class="docfoot__label">previous</span>
            <span class="docfoot__title">{prev.text}</span>
          </a>
        )}
      </div>
      <div class="docfoot__slot docfoot__slot--next">
        {next && (
          <a class="docfoot__link docfoot__link--next" href={next.link}>
            <span class="docfoot__label">next</span>
            <span class="docfoot__title">{next.text}</span>
          </a>
        )}
      </div>
    </nav>
  )
}

<style>
  .docfoot__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--c-divider);
  }

  .docfoot__edit {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--c-brand-1);
    text-decoration: none;
  }

  .docfoot__edit:hover {
    color: var(--c-brand-2);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .docfoot__updated {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--c-text-3);
  }

  .docfoot__nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .docfoot__slot--next {
    text-align: right;
  }

  .docfoot__link {
    display: block;
    height: 100%;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--c-divider);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition:
      border-color var(--duration-normal) var(--ease),
      background-color var(--duration-normal) var(--ease);
  }

  .docfoot__link:hover {
    border-color: var(--c-brand-2);
    background: var(--c-brand-softer);
  }

  .docfoot__label {
    display: block;
    margin-bottom: var(--space-1);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--c-text-3);
  }

  .docfoot__title {
    display: block;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--c-brand-1);
  }

  @media (max-width: 640px) {
    .docfoot__nav {
      grid-template-columns: 1fr;
    }

    .docfoot__slot--next {
      text-align: left;
    }
  }
</style>
