---
import type { NavItem } from "../lib/guideNav";

interface Props {
  prev?: NavItem | null;
  next?: NavItem | null;
  updated?: Date;
}

const { prev = null, next = null, updated } = Astro.props;

const updatedLabel = updated
  ? updated.toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
      // Frontmatter dates are UTC midnight; formatting them locally
      // renders the previous day anywhere west of UTC.
      timeZone: "UTC",
    })
  : null;
---

{
  (prev || next) && (
    <nav class="docfoot__nav" aria-label="Guide">
      <div class="docfoot__slot">
        {prev && (
          <a class="docfoot__link" href={prev.link}>
            <svg
              class="docfoot__arrow"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="19" y1="12" x2="5" y2="12" />
              <polyline points="12 19 5 12 12 5" />
            </svg>
            <span>{prev.text}</span>
          </a>
        )}
      </div>
      <div class="docfoot__slot docfoot__slot--next">
        {next && (
          <a class="docfoot__link docfoot__link--next" href={next.link}>
            <span>{next.text}</span>
            <svg
              class="docfoot__arrow"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="12 5 19 12 12 19" />
            </svg>
          </a>
        )}
      </div>
    </nav>
  )
}

<div class="docfoot__meta">
  {
    updatedLabel && (
      <p class="docfoot__updated">
        last updated <time datetime={updated!.toISOString()}>{updatedLabel}</time>
      </p>
    )
  }
  <p class="docfoot__built">built by progsu &copy;</p>
</div>

<style>
  .docfoot__nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4) var(--space-8);
    margin-top: var(--space-12);
  }

  .docfoot__slot {
    display: flex;
  }

  .docfoot__slot--next {
    justify-content: flex-end;
  }

  .docfoot__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--c-text-1);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: color var(--duration-fast) var(--ease);
  }

  .docfoot__link--next {
    text-align: right;
  }

  .docfoot__link:hover {
    color: var(--c-brand-1);
  }

  .docfoot__link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .docfoot__arrow {
    flex: none;
    color: var(--c-brand-1);
    transition: transform var(--duration-fast) var(--ease);
  }

  .docfoot__link:hover .docfoot__arrow {
    transform: translateX(-2px);
  }

  .docfoot__link--next:hover .docfoot__arrow {
    transform: translateX(2px);
  }

  .docfoot__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--c-divider);
  }

  .docfoot__nav + .docfoot__meta {
    margin-top: var(--space-6);
  }

  .docfoot__updated,
  .docfoot__built {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--c-text-2);
  }

  .docfoot__built {
    margin-left: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .docfoot__arrow {
      transition: none;
    }

    .docfoot__link:hover .docfoot__arrow,
    .docfoot__link--next:hover .docfoot__arrow {
      transform: none;
    }
  }

  @media (max-width: 640px) {
    .docfoot__nav {
      grid-template-columns: 1fr;
    }
  }
</style>
