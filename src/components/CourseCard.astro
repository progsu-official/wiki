---
interface Props {
  code: string;
  title: string;
  credits: number;
  professor?: string;
  meeting?: string;
  room?: string;
  seats?: number;
  seatsCap?: number;
  pick?: boolean;
  variant?: "default" | "compact" | "summary" | "code-only";
  sectionCount?: number;
}

const {
  code,
  title,
  credits,
  professor,
  meeting,
  room,
  seats,
  seatsCap,
  pick = false,
  variant = "default",
  sectionCount,
} = Astro.props;

const seatStatus: "open" | "low" | "full" =
  seats == null ? "open" : seats <= 0 ? "full" : seats <= 5 ? "low" : "open";

const seatWord = seatStatus === "full" ? "full" : seatStatus === "low" ? "left" : "open";
const seatBadgeClass =
  seatStatus === "full" ? "badge--danger" : seatStatus === "low" ? "badge--warning" : "";

const slug = code.toLowerCase().replace(" ", "-");
---

{
  variant === "code-only" ? (
    <div
      class="cc cc--code-only card card--link"
      data-course-tile={code}
      role="button"
      tabindex="0"
      aria-label={`${code} — ${title}`}
    >
      <span class="cc__code">{code}</span>
    </div>
  ) : variant === "summary" ? (
    <div
      class="cc cc--summary card card--link"
      data-course-tile={code}
      role="button"
      tabindex="0"
      aria-label={`${code} — ${title}`}
    >
      {pick && <span class="badge badge--brand cc__pick">progsu pick</span>}
      <div class="cc__code-row">
        <span class="cc__code">{code}</span>
        <span class="cc__credits">{credits} cr</span>
      </div>
      <span class="cc__title">{title}</span>
      {sectionCount != null && (
        <span class="cc__meta">
          {sectionCount} section{sectionCount !== 1 ? "s" : ""}
        </span>
      )}
    </div>
  ) : (
    <a
      href={`/courses/${slug}`}
      class:list={["cc", "card", "card--link", `cc--${variant}`]}
      data-cc-link
    >
      {pick && <span class="badge badge--brand cc__pick">progsu pick</span>}

      <div class="cc__code-row">
        <span class="cc__code">{code}</span>
        <span class="cc__credits">{credits} cr</span>
        {seats != null && (
          <span class:list={["badge", "cc__seats", seatBadgeClass]}>
            {seats}/{seatsCap} {seatWord}
          </span>
        )}
      </div>

      <span class="cc__title">{title}</span>

      {(professor || meeting || room) && (
        <span class="cc__meta">{[professor, meeting, room].filter(Boolean).join(" · ")}</span>
      )}

      <div class="cc__footer">
        <button
          class="cc__star"
          aria-label={`Star ${code}`}
          aria-pressed="false"
          type="button"
          data-star-code={code}
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
          </svg>
        </button>
        <span class="cc__details" aria-hidden="true">
          &rarr;
        </span>
      </div>
    </a>
  )
}

<style>
  .cc.card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    cursor: pointer;
  }

  /* ── Pick eyebrow ── */
  .cc__pick {
    align-self: flex-start;
  }

  /* ── Code row ── */
  .cc__code-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .cc__code {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--c-brand-1);
  }

  .cc__credits {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--c-text-3);
  }

  .cc__seats.badge {
    font-family: var(--font-mono);
    font-weight: 500;
    margin-left: auto;
  }

  /* ── Title ── */
  .cc__title {
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    color: var(--c-text-1);
    line-height: var(--leading-snug);
  }

  /* ── Meta ── */
  .cc__meta {
    font-size: var(--text-sm);
    color: var(--c-text-3);
    line-height: var(--leading-normal);
  }

  /* ── Footer ── */
  .cc__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--space-1);
  }

  .cc__star {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin: -8px;
    background: none;
    border: none;
    color: var(--c-text-3);
    cursor: pointer;
    border-radius: var(--radius-md);
    padding: 0;
    transition: color var(--duration-fast) var(--ease);
  }
  .cc__star:hover {
    color: var(--c-brand-1);
  }
  .cc__star.starred {
    color: var(--c-brand-1);
  }
  .cc__star.starred svg {
    fill: currentColor;
  }
  .cc__star.pop {
    animation: starPop 0.3s var(--ease-out);
  }

  @keyframes starPop {
    0% {
      transform: scale(1);
    }
    40% {
      transform: scale(1.4);
    }
    100% {
      transform: scale(1);
    }
  }

  .cc__details {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--c-text-3);
    transition: color var(--duration-normal) var(--ease);
  }
  .cc:hover .cc__details {
    color: var(--c-brand-1);
  }

  /* ── Compact variant ── */
  .cc--compact.card {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-3) var(--space-5);
  }

  .cc--compact .cc__pick {
    width: 100%;
  }

  .cc--compact .cc__code-row {
    flex-shrink: 0;
    flex-wrap: nowrap;
  }

  .cc--compact .cc__seats.badge {
    margin-left: 0;
  }

  .cc--compact .cc__title {
    flex: 1;
    min-width: 0;
    font-size: var(--text-sm);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cc--compact .cc__meta {
    width: 100%;
  }

  .cc--compact .cc__footer {
    margin-top: 0;
    margin-left: auto;
    gap: var(--space-3);
  }

  /* ── Code-only variant (minimal tile) ── */
  .cc--code-only.card {
    align-items: center;
    justify-content: center;
    padding: var(--space-3) var(--space-4);
    min-height: 44px;
  }

  /* ── Summary variant (course picker tile) ── */
  .cc--summary.card {
    gap: var(--space-2);
    padding: var(--space-5);
  }
  .cc--summary .cc__title {
    font-size: var(--text-sm);
  }

  @media (max-width: 480px) {
    .cc.card {
      padding: var(--space-4);
    }
    .cc--compact.card {
      flex-direction: column;
      align-items: stretch;
    }
    .cc--compact .cc__title {
      white-space: normal;
    }
    .cc--compact .cc__footer {
      margin-left: 0;
    }
  }
</style>
