---
import Badge from "./Badge.astro";

type Icon = "compass" | "briefcase" | "code" | "users" | "layers";

interface Props {
  title: string;
  href: string;
  description: string;
  count: number;
  icon: Icon;
  variant?: "featured" | "default";
  eyebrow?: string;
}

const { title, href, description, count, icon, variant = "default", eyebrow } = Astro.props;

const ICONS: Record<Icon, string> = {
  compass:
    "M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20zM16.24 7.76l-2.12 6.36-6.36 2.12 2.12-6.36 6.36-2.12z",
  briefcase:
    "M20 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2zM16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16",
  code: "M16 18l6-6-6-6M8 6l-6 6 6 6",
  users:
    "M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75",
  layers: "M12 2l9 4.9v10.2L12 22l-9-4.9V6.9L12 2zM3.27 6.96L12 12.01l8.73-5.05M12 22.08V12",
};

const countLabel = `${count} ${count === 1 ? "guide" : "guides"}`;
---

<a
  href={href}
  class:list={["card", "card--link", "cat", variant === "featured" && "cat--featured"]}
>
  {variant === "featured" && <span class="cat__sheen" aria-hidden="true" />}

  <span class="card__icon cat__icon" aria-hidden="true">
    <svg
      width="22"
      height="22"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d={ICONS[icon]}></path>
    </svg>
  </span>

  {
    eyebrow && (
      <span class="cat__eyebrow">
        <Badge text={eyebrow} variant="brand" />
      </span>
    )
  }

  <span class="cat__head">
    <h2 class="card__title cat__title">{title}</h2>
    <span class="cat__count">{countLabel}</span>
  </span>

  <p class="card__text">{description}</p>

  <span class="cat__arrow" aria-hidden="true">&rarr;</span>
</a>

<style>
  a.cat {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: var(--space-6);
  }

  a.cat .cat__icon {
    width: 40px;
    height: 40px;
    margin-bottom: var(--space-4);
  }

  .cat__eyebrow {
    display: block;
    margin-bottom: var(--space-3);
  }

  .cat__head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  h2.cat__title {
    margin: 0;
  }

  .cat__count {
    font-size: var(--text-sm);
    color: var(--c-text-2);
  }

  .cat__arrow {
    position: absolute;
    top: var(--space-6);
    right: var(--space-6);
    font-size: var(--text-base);
    line-height: 1;
    color: var(--c-text-3);
    transition:
      color var(--duration-normal) var(--ease),
      transform var(--duration-normal) var(--ease);
  }

  a.cat:hover .cat__arrow {
    color: var(--c-brand-1);
    transform: translateX(4px);
  }

  /* The entry point spans the full grid, reads a size larger, and is the one
     animated surface here: a purple slab whose gradient drifts, with a slow
     specular sheen crossing it. Every stop stays dark enough to hold white
     text — #7e22ce is the lightest, 6.98:1 on white. */
  a.cat--featured {
    grid-column: 1 / -1;
    isolation: isolate;
    color: #fff;
    border-color: rgba(255, 255, 255, 0.14);
    background-color: #4c1d95;
    background-image:
      radial-gradient(
        ellipse 70% 100% at 18% 0%,
        rgba(255, 255, 255, 0.05),
        rgba(255, 255, 255, 0) 62%
      ),
      linear-gradient(
        115deg,
        #4c1d95 0%,
        #5b21b6 18%,
        #6d28d9 38%,
        #7e22ce 52%,
        #6d28d9 68%,
        #5b21b6 84%,
        #4c1d95 100%
      );
    background-size:
      170% 170%,
      230% 230%;
    background-position:
      0% 0%,
      0% 50%;
    box-shadow:
      var(--shadow-sm),
      0 6px 20px rgba(109, 40, 217, 0.22);
    animation: cat-drift 26s ease-in-out infinite alternate;
    transition:
      box-shadow var(--duration-normal) var(--ease),
      transform var(--duration-normal) var(--ease),
      border-color var(--duration-normal) var(--ease);
  }

  @keyframes cat-drift {
    to {
      background-position:
        100% 70%,
        100% 50%;
    }
  }

  /* The hover ring the global .card rules fade in via ::after would be purple
     on purple here, so it inverts to a light rim. */
  a.cat.cat--featured::after {
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.55),
      rgba(255, 255, 255, 0.14) 50%,
      rgba(255, 255, 255, 0.45)
    );
  }

  /* The light rim from ::after takes over from the resting border, the same
     handoff the global .card hover does. */
  a.cat.cat--featured:hover {
    color: #fff;
    border-color: transparent;
    box-shadow:
      var(--shadow-md),
      0 14px 34px rgba(109, 40, 217, 0.38);
  }

  a.cat.cat--featured:focus-visible {
    box-shadow:
      var(--focus-ring),
      0 14px 34px rgba(109, 40, 217, 0.38);
  }

  /* Sheen: the wrapper clips to the card and carries the hover intensity, the
     pseudo-element carries the sweep. Splitting them keeps the hover fade off
     the animated opacity. */
  .cat--featured .cat__sheen {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0.8;
    transition: opacity var(--duration-slow) var(--ease);
  }

  a.cat.cat--featured:hover .cat__sheen {
    opacity: 1;
  }

  .cat--featured .cat__sheen::before {
    content: "";
    position: absolute;
    top: -60%;
    bottom: -60%;
    left: -40%;
    width: 40%;
    background: linear-gradient(
      100deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.04) 38%,
      rgba(255, 255, 255, 0.1) 50%,
      rgba(255, 255, 255, 0.04) 62%,
      rgba(255, 255, 255, 0) 100%
    );
    transform: translate3d(0, 0, 0) rotate(16deg);
    will-change: transform;
    animation: cat-sheen 11s ease-in-out infinite;
  }

  @keyframes cat-sheen {
    0% {
      transform: translate3d(0, 0, 0) rotate(16deg);
      opacity: 0;
    }
    8%,
    36% {
      opacity: 1;
    }
    46%,
    100% {
      transform: translate3d(420%, 0, 0) rotate(16deg);
      opacity: 0;
    }
  }

  .cat--featured .cat__icon,
  .cat--featured .cat__eyebrow,
  .cat--featured .cat__head,
  .cat--featured .card__text {
    position: relative;
    z-index: 2;
  }

  .cat--featured .cat__icon {
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.16);
  }

  /* The eyebrow badge inverts to a light pill, as .btn--alt does on a band. */
  .cat--featured :global(.badge--brand) {
    background: rgba(255, 255, 255, 0.94);
    color: #4c1d95;
  }

  .cat--featured .cat__title {
    font-size: var(--text-xl);
    color: #fff;
  }

  .cat--featured .cat__count {
    color: rgba(255, 255, 255, 0.92);
  }

  .cat--featured .card__text {
    font-size: var(--text-base);
    color: rgba(255, 255, 255, 0.92);
  }

  .cat--featured .cat__arrow {
    z-index: 2;
    color: rgba(255, 255, 255, 0.8);
  }

  a.cat.cat--featured:hover .cat__arrow {
    color: #fff;
  }

  /* Dark theme keeps the slab saturated but sits it a shade deeper so it
     doesn't glare beside the muted cards. Lightest stop #6d28d9, 7.10:1. */
  :global(html.dark) a.cat--featured {
    background-color: #3d2377;
    background-image:
      radial-gradient(
        ellipse 70% 100% at 18% 0%,
        rgba(255, 255, 255, 0.06),
        rgba(255, 255, 255, 0) 62%
      ),
      linear-gradient(
        115deg,
        #3d2377 0%,
        #4c1d95 20%,
        #5b21b6 40%,
        #6d28d9 52%,
        #5b21b6 68%,
        #4c1d95 84%,
        #3d2377 100%
      );
    box-shadow:
      var(--shadow-sm),
      0 6px 22px rgba(124, 58, 237, 0.26);
  }

  :global(html.dark) a.cat.cat--featured:hover {
    box-shadow:
      var(--shadow-md),
      0 14px 38px rgba(124, 58, 237, 0.42);
  }

  :global(html.dark) a.cat.cat--featured:focus-visible {
    box-shadow:
      var(--focus-ring),
      0 14px 38px rgba(124, 58, 237, 0.42);
  }

  /* Frozen on a chosen frame: gradient parked on its bright middle, sheen
     parked as a static highlight across the upper right. */
  @media (prefers-reduced-motion: reduce) {
    a.cat--featured {
      animation: none;
      background-position:
        62% 40%,
        58% 50%;
    }

    .cat--featured .cat__sheen::before {
      animation: none;
      opacity: 1;
      transform: translate3d(215%, 0, 0) rotate(16deg);
    }
  }

  @media (max-width: 480px) {
    a.cat {
      padding: var(--space-5);
    }

    .cat__arrow {
      top: var(--space-5);
      right: var(--space-5);
    }
  }
</style>
