---
import { NAV_LINKS } from "../consts";
import ThemeToggle from "./ThemeToggle.astro";
import SocialRow from "./SocialRow.astro";

const currentPath = Astro.url.pathname;

function isExternal(href: string): boolean {
  return href.startsWith("http");
}

function isActive(href: string): boolean {
  if (isExternal(href)) return false;
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<a href="#main-content" class="skip-link">skip to content</a>

<header class="navbar" id="site-navbar" role="banner">
  <div class="navbar__inner container">
    <a href="/" class="navbar__brand">
      <span class="navbar__brand-name">progsu</span>
      <span class="navbar__brand-sep" aria-hidden="true">/</span>
      <span class="navbar__brand-sub">wiki</span>
    </a>

    <nav class="navbar__links" id="nav-menu" aria-label="Main">
      {
        NAV_LINKS.map((link) => {
          const external = isExternal(link.href);
          const active = isActive(link.href);
          return (
            <a
              href={link.href}
              class:list={["navbar__link", { "is-active": active }]}
              aria-current={active ? "page" : undefined}
              {...(external ? { target: "_blank", rel: "noopener" } : {})}
            >
              {link.label}
              {external && (
                <svg
                  class="navbar__external"
                  width="11"
                  height="11"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M7 17 17 7" />
                  <path d="M8 7h9v9" />
                </svg>
              )}
            </a>
          );
        })
      }
    </nav>

    <div class="navbar__actions">
      <button class="navbar__search" id="nav-search-open" type="button" aria-label="Search">
        <svg
          class="navbar__search-icon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <span class="navbar__search-label">search</span>
        <kbd class="navbar__search-keys" id="nav-search-keys" aria-hidden="true">⌘K</kbd>
      </button>

      <span class="navbar__rule" aria-hidden="true"></span>

      <ThemeToggle />

      <div class="navbar__social">
        <SocialRow compact />
      </div>

      <button
        class="navbar__toggle"
        id="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="nav-menu"
        aria-label="Open menu"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <line class="navbar__bar navbar__bar--top" x1="3" y1="5" x2="17" y2="5"></line>
          <line class="navbar__bar navbar__bar--mid" x1="3" y1="10" x2="17" y2="10"></line>
          <line class="navbar__bar navbar__bar--bot" x1="3" y1="15" x2="17" y2="15"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    height: var(--nav-height);
    /* The shell reserves exactly 64px, so the border must sit inside it. */
    box-sizing: border-box;
    background: var(--c-bg);
    /* Held transparent so the rule can appear on scroll without a height shift. */
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-normal) var(--ease);
  }
  .navbar.is-scrolled {
    border-bottom-color: var(--c-divider);
  }

  .navbar__inner {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    height: 100%;
  }

  /* ── Wordmark ── */
  .navbar__brand {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--c-text-1);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .navbar__brand:hover {
    color: var(--c-text-1);
  }
  .navbar__brand-sep,
  .navbar__brand-sub {
    color: var(--c-text-3);
    font-weight: 500;
  }

  /* ── Links ── */
  .navbar__links {
    display: none;
  }

  .navbar__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: 14px;
    font-weight: 500;
    color: var(--c-text-2);
    transition: color var(--duration-fast) var(--ease);
  }
  .navbar__link:hover {
    color: var(--c-text-1);
  }
  .navbar__link.is-active {
    color: var(--c-brand-1);
    font-weight: 600;
  }

  .navbar__external {
    color: var(--c-text-3);
    flex-shrink: 0;
  }

  /* ── Right-hand actions ── */
  .navbar__actions {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin-left: auto;
  }

  .navbar__rule {
    display: none;
    width: 1px;
    height: 24px;
    background: var(--c-divider);
    margin-inline: var(--space-4);
    flex-shrink: 0;
  }

  /* ── Search ── */
  .navbar__search {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: 44px;
    width: 44px;
    justify-content: center;
    padding: 0;
    border: none;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--c-text-3);
    font-family: var(--font-body);
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease),
      color var(--duration-fast) var(--ease);
  }
  .navbar__search:hover {
    color: var(--c-text-1);
    background: var(--c-bg-soft);
  }

  .navbar__search-icon {
    flex-shrink: 0;
  }

  .navbar__search-label,
  .navbar__search-keys {
    display: none;
  }

  /* ── Social ── */
  .navbar__social {
    display: none;
  }

  /* ── Hamburger ── */
  .navbar__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: none;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--c-text-2);
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease);
  }
  .navbar__toggle:hover {
    color: var(--c-text-1);
  }

  .navbar__bar {
    transition:
      transform var(--duration-normal) var(--ease),
      opacity var(--duration-fast) var(--ease);
  }
  .navbar__bar--top {
    transform-origin: 10px 5px;
  }
  .navbar__bar--mid {
    transform-origin: 10px 10px;
  }
  .navbar__bar--bot {
    transform-origin: 10px 15px;
  }
  .navbar__toggle[aria-expanded="true"] .navbar__bar--top {
    transform: translate(0, 5px) rotate(45deg);
  }
  .navbar__toggle[aria-expanded="true"] .navbar__bar--mid {
    opacity: 0;
  }
  .navbar__toggle[aria-expanded="true"] .navbar__bar--bot {
    transform: translate(0, -5px) rotate(-45deg);
  }

  /* ── Mobile dropdown ── */
  @media (max-width: 767px) {
    .navbar__links.is-open {
      display: flex;
      flex-direction: column;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--c-bg);
      border-bottom: 1px solid var(--c-divider);
      box-shadow: var(--shadow-lg);
      padding: var(--space-2) var(--space-6) var(--space-4);
    }

    .navbar__links.is-open .navbar__link {
      min-height: 44px;
      font-size: 15px;
      border-bottom: 1px solid var(--c-divider);
    }
    .navbar__links.is-open .navbar__link:last-child {
      border-bottom: none;
    }
  }

  /* .container narrows its gutter here; the dropdown has to follow. */
  @media (max-width: 640px) {
    .navbar__links.is-open {
      padding-inline: var(--space-5);
    }
  }

  /* ── Desktop ── */
  @media (min-width: 768px) {
    .navbar__links {
      display: flex;
      align-items: center;
      gap: var(--space-6);
      margin-left: auto;
    }

    .navbar__actions {
      margin-left: 0;
    }

    .navbar__toggle {
      display: none;
    }

    .navbar__rule {
      display: block;
    }

    .navbar__search {
      width: auto;
      height: 32px;
      justify-content: flex-start;
      padding: 0 var(--space-2) 0 var(--space-3);
      background: var(--c-bg-soft);
    }
    .navbar__search:hover {
      background: var(--c-bg-mute);
    }

    .navbar__search-label {
      display: inline;
      font-size: 13px;
      line-height: 1;
    }

    .navbar__search-keys {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 24px;
      height: 20px;
      padding: 0 var(--space-1);
      border: 1px solid var(--c-divider);
      border-radius: var(--radius-sm);
      background: var(--c-bg);
      color: var(--c-text-3);
      font-family: var(--font-mono);
      font-size: 11px;
      line-height: 1;
    }
  }

  @media (min-width: 1280px) {
    .navbar__social {
      display: block;
    }
  }
</style>

<script>
  const navbar = document.getElementById("site-navbar");
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("nav-menu");

  if (navbar) {
    const onScroll = () => {
      navbar.classList.toggle("is-scrolled", window.scrollY > 0);
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      menu.classList.toggle("is-open", open);
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && menu.classList.contains("is-open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener("click", (e) => {
      const target = e.target as Node;
      if (
        menu.classList.contains("is-open") &&
        !menu.contains(target) &&
        !toggle.contains(target)
      ) {
        setOpen(false);
      }
    });
  }

  document.getElementById("nav-search-open")?.addEventListener("click", () => {
    (window as any).openSiteSearch?.();
  });

  // The search shortcut is ctrl+k off Apple platforms; show what actually works.
  const keys = document.getElementById("nav-search-keys");
  if (keys && !/Mac|iPhone|iPad|iPod/.test(navigator.platform || "")) {
    keys.textContent = "ctrl K";
  }
</script>
