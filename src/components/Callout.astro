---
/**
 * Emits the exact markup src/lib/remark-callouts.mjs injects into vault
 * markdown, so both share the `.callout` rules in global.css. Change one,
 * change the other.
 */
interface Props {
  variant?: "info" | "warning" | "tip" | "danger";
  title?: string;
}

const { variant = "info", title } = Astro.props;

const icons: Record<string, string> = {
  info: "M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
  warning:
    "M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z",
  tip: "M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z",
  danger: "M21 12a9 9 0 11-18 0 9 9 0 0118 0zM15 9l-6 6M9 9l6 6",
};

const labels: Record<string, string> = {
  info: "Info",
  warning: "Warning",
  tip: "Tip",
  danger: "Danger",
};
---

<aside class={`callout callout--${variant}`} role="note" aria-label={title || labels[variant]}>
  <div class="callout__icon" aria-hidden="true">
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d={icons[variant]}></path>
    </svg>
  </div>
  <div class="callout__body">
    {title && <p class="callout__title">{title}</p>}
    <div class="callout__content">
      <slot />
    </div>
  </div>
</aside>
