---
import Badge from "./Badge.astro";

interface Props {
  /** Set with set:html, so a <br> in the headline still breaks the line. */
  title: string;
  /** One warm line under the title, on index pages. */
  intro?: string;
  /** One muted line under the title, on article pages. Also draws the rule. */
  meta?: string;
  tags?: string[];
}

const { title, intro, meta, tags = [] } = Astro.props;
---

<header class="head">
  <h1 class="head__title" set:html={title} />
  {intro && <p class="head__intro">{intro}</p>}
  {meta && <p class="head__meta">{meta}</p>}
  {
    tags.length > 0 && (
      <div class="head__tags">
        {tags.map((tag) => (
          <Badge text={tag} />
        ))}
      </div>
    )
  }
  {meta && <div class="divider head__rule" />}
</header>

<style>
  .head {
    margin-bottom: var(--space-8);
  }

  .head__title {
    margin: 0;
    font-size: var(--text-4xl);
    font-weight: 700;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--c-text-1);
  }

  .head__intro {
    margin: var(--space-4) 0 0;
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    color: var(--c-text-2);
  }

  .head__meta {
    margin: var(--space-3) 0 0;
    font-size: var(--text-sm);
    color: var(--c-text-3);
  }

  .head__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .head__rule {
    margin-top: var(--space-8);
  }
</style>
