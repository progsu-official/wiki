---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import PageHeader from "../../../components/PageHeader.astro";
import Badge from "../../../components/Badge.astro";
import GuideCard from "../../../components/GuideCard.astro";

const guides = (await getCollection("guides", (entry) => entry.data.category === "networking")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<Layout title="Networking" accent="cyan">
  <Breadcrumb items={[
    { label: "Home", href: "/" },
    { label: "Guides", href: "/guides" },
    { label: "Networking" },
  ]} />

  <PageHeader
    eyebrow="networking"
    headline="know the right<br>people."
    subline="Cold outreach, LinkedIn strategy, warm intros, and how to build relationships that actually open doors."
  />

  {guides.length > 0 ? (
    <div class="guide-list">
      {guides.map((guide) => (
        <GuideCard
          title={guide.data.title}
          href={`/guides/networking/${guide.slug.split("/")[1]}`}
          readTime={guide.data.readTime}
          authorName={guide.data.author.name}
          tags={guide.data.tags}
        />
      ))}
    </div>
  ) : (
    <Badge text="guides coming soon" />
  )}
</Layout>

<style>
  .guide-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
</style>
