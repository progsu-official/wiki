---
import { getCollection } from "astro:content";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import GuideCard from "../../../components/GuideCard.astro";
import { getGuideNav } from "../../../lib/guideNav";

const intro =
  "leetcode patterns, system design fundamentals, and take-homes — how to prep without just grinding.";

// Listed in the sidebar's reading order, so the two never disagree on screen.
const { flat } = await getGuideNav();
const order = (slug: string) => {
  const i = flat.findIndex((item) => item.link === `/guides/${slug}`);
  return i === -1 ? flat.length : i;
};

const guides = (await getCollection("guides", (entry) => entry.data.category === "technical")).sort(
  (a, b) => order(a.slug) - order(b.slug)
);
---

<DocsLayout title="technical" description={intro}>
  <PageHeader title="technical" intro={intro} />

  {
    guides.length > 0 ? (
      <div class="guides">
        {guides.map((guide) => (
          <GuideCard
            title={guide.data.title}
            href={`/guides/${guide.slug}`}
            readTime={guide.data.readTime}
            authorName={guide.data.author.name}
            tags={guide.data.tags}
          />
        ))}
      </div>
    ) : (
      <p class="empty">nothing here yet. guides show up as members write them.</p>
    )
  }
</DocsLayout>

<style>
  .guides {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .empty {
    margin: 0;
    color: var(--c-text-2);
  }
</style>
