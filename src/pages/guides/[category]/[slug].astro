---
import { getCollection } from "astro:content";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";

export async function getStaticPaths() {
  // Top-level guides only (category/slug). Nested guides — zero-to-hero/roadmap-by-year/*
  // — get their own route so they don't collide with their container page, and
  // roadmap-by-year itself is a card index, not rendered markdown.
  const entries = await getCollection(
    "guides",
    (entry) => entry.slug.split("/").length === 2 && entry.slug !== "zero-to-hero/roadmap-by-year"
  );
  return entries.map((entry) => {
    const [category, slug] = entry.slug.split("/");
    return { params: { category, slug }, props: { entry } };
  });
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();

// The page owns the title, so the markdown's own lede heading has to give way.
// Some vault guides repeat the title in it; others use `#` as their section
// marker all the way down. Both cases have to land on one visible h1.
const norm = (s: string) =>
  s
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, " ")
    .trim();
const lead = headings[0];
const leadRepeatsTitle = lead?.depth === 1 && norm(lead.text) === norm(entry.data.title);
const body = leadRepeatsTitle ? headings.slice(1) : headings;
const shift = body.some((h) => h.depth === 1);
const toc = shift ? body.map((h) => ({ ...h, depth: h.depth + 1 })) : body;

const updated = entry.data.updated.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  // Frontmatter dates are UTC midnight; formatting them locally renders
  // the previous day anywhere west of UTC.
  timeZone: "UTC",
});
const meta = `${entry.data.readTime} · by ${entry.data.author.name} · updated ${updated}`;
---

<DocsLayout
  title={entry.data.title}
  headings={toc}
  editSlug={entry.slug}
  updated={entry.data.updated}
>
  <PageHeader title={entry.data.title} meta={meta} tags={entry.data.tags} />

  <div
    class:list={[
      "prose",
      "guide-body",
      { "guide-body--drop-lead": leadRepeatsTitle, "guide-body--sections": shift },
    ]}
  >
    <Content />
  </div>
</DocsLayout>

<style>
  /* The lede heading only repeats what the page head already says. */
  .guide-body.prose.guide-body--drop-lead > :global(h1:first-child) {
    display: none;
  }

  /* With it hidden, whatever follows becomes the first thing on the page and
     should sit flush under the head rule rather than under a second one. */
  .guide-body.prose.guide-body--drop-lead > :global(h1:first-child + *) {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  /* Guides that use `#` for their sections: read those as h2s would read. */
  .guide-body.prose.guide-body--sections > :global(h1) {
    font-size: 24px;
    line-height: 32px;
    margin: 48px 0 16px;
    padding-top: 24px;
    border-top: 1px solid var(--c-divider);
  }

  .guide-body.prose.guide-body--sections > :global(h1:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }
</style>
