---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import PageHeader from "../../../components/PageHeader.astro";
import Badge from "../../../components/Badge.astro";
import GuideCard from "../../../components/GuideCard.astro";

const guides = (
  await getCollection(
    "guides",
    // top-level only, nested entries (roadmap-by-year/*) live on their own container page
    (entry) => entry.data.category === "zero-to-hero" && entry.slug.split("/").length === 2,
  )
).sort((a, b) => {
  const aSlug = a.slug.split("/")[1];
  const bSlug = b.slug.split("/")[1];
  if (aSlug === "getting-started") return -1;
  if (bSlug === "getting-started") return 1;
  return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
});
---

<Layout title="Zero to Hero">
  <Breadcrumb items={[
    { label: "Home", href: "/" },
    { label: "Guides", href: "/guides" },
    { label: "Zero to Hero" },
  ]} />

  <PageHeader
    eyebrow="Zero to Hero"
    headline="the bedrock<br>of everything."
    subline="CS theory, math, and first principles every student should have solid footing in before chasing offers."
  />

  {guides.length > 0 ? (
    <div class="guide-list">
      {guides.map((guide) => (
        <GuideCard
          title={guide.data.title}
          href={`/guides/zero-to-hero/${guide.slug.split("/")[1]}`}
          readTime={guide.data.readTime}
          authorName={guide.data.author.name}
          tags={guide.data.tags}
          badge={guide.slug.split("/")[1] === "getting-started" ? "start here" : undefined}
        />
      ))}
    </div>
  ) : (
    <Badge text="guides coming soon" />
  )}
</Layout>

<style>
  .guide-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
</style>
