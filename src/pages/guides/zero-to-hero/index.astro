---
import { getCollection } from "astro:content";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import GuideCard from "../../../components/GuideCard.astro";
import { getGuideNav } from "../../../lib/guideNav";

const intro =
  "the path from no idea what you're doing to an offer in hand. read getting started first, then work down the list.";

// Listed in the sidebar's reading order, with getting-started pinned to the top.
const { flat } = await getGuideNav();
const order = (slug: string) => {
  if (slug.endsWith("/getting-started")) return -1;
  const i = flat.findIndex((item) => item.link === `/guides/${slug}`);
  return i === -1 ? flat.length : i;
};

// Top level only — the roadmap's per-year guides live on their own page.
const guides = (
  await getCollection(
    "guides",
    (entry) => entry.data.category === "zero-to-hero" && entry.slug.split("/").length === 2
  )
).sort((a, b) => order(a.slug) - order(b.slug));
---

<DocsLayout title="zero to hero" description={intro}>
  <PageHeader title="zero to hero" intro={intro} />

  {
    guides.length > 0 ? (
      <div class="guides">
        {guides.map((guide) => (
          <GuideCard
            title={guide.data.title}
            href={`/guides/${guide.slug}`}
            readTime={guide.data.readTime}
            authorName={guide.data.author.name}
            tags={guide.data.tags}
            badge={guide.slug.endsWith("/getting-started") ? "start here" : undefined}
          />
        ))}
      </div>
    ) : (
      <p class="empty">nothing here yet. guides show up as members write them.</p>
    )
  }
</DocsLayout>

<style>
  .guides {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .empty {
    margin: 0;
    color: var(--c-text-2);
  }
</style>
