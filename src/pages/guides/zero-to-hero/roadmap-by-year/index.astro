---
import { getCollection } from "astro:content";
import DocsLayout from "../../../../layouts/DocsLayout.astro";
import PageHeader from "../../../../components/PageHeader.astro";
import GuideCard from "../../../../components/GuideCard.astro";
import { getGuideNav } from "../../../../lib/guideNav";

const intro =
  "what to focus on each year, which classes to prioritize, and how to step it up as you go.";

// The year order already lives in guideNav; reuse it rather than restate it.
const { flat } = await getGuideNav();
const order = (slug: string) => {
  const i = flat.findIndex((item) => item.link === `/guides/${slug}`);
  return i === -1 ? flat.length : i;
};

const years = (
  await getCollection("guides", (entry) => entry.slug.startsWith("zero-to-hero/roadmap-by-year/"))
).sort((a, b) => order(a.slug) - order(b.slug));
---

<DocsLayout title="roadmap by year" description={intro}>
  <PageHeader title="roadmap by year" intro={intro} />

  {
    years.length > 0 ? (
      <div class="guides">
        {years.map((year) => (
          <GuideCard
            title={year.data.title}
            href={`/guides/${year.slug}`}
            readTime={year.data.readTime}
            authorName={year.data.author.name}
            tags={year.data.tags}
          />
        ))}
      </div>
    ) : (
      <p class="empty">nothing here yet. the per-year guides show up as members write them.</p>
    )
  }
</DocsLayout>

<style>
  .guides {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .empty {
    margin: 0;
    color: var(--c-text-2);
  }
</style>
