---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import HeroBand from "../components/HeroBand.astro";

// roadmap-by-year is frontmatter-only — it exists so wikilinks resolve, and it
// renders as a card index rather than a guide, so it isn't counted.
const guides = (await getCollection("guides")).filter(
  (g) => g.slug !== "zero-to-hero/roadmap-by-year"
);
const countFor = (category: string) => guides.filter((g) => g.data.category === category).length;

// The foot of the hero is the three most recently updated guides, one per
// category. Sorted on date alone the top three are all zero-to-hero, and a
// strip of neighbours says less about the wiki than a strip that spans it.
const seenCategories = new Set<string>();
const recent = [...guides]
  .sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf())
  .filter((guide) => {
    if (seenCategories.has(guide.data.category)) return false;
    seenCategories.add(guide.data.category);
    return true;
  })
  .slice(0, 3)
  .map((guide) => ({
    // Titles stay as written, the way every other guide listing renders them.
    title: guide.data.title,
    category: guide.data.category.replace(/-/g, " "),
    href: `/guides/${guide.slug}`,
  }));

const topics = ["zero-to-hero", "career", "technical", "networking", "misc"].map((slug) => ({
  title: slug.replace(/-/g, " "),
  href: `/guides/${slug}`,
  count: countFor(slug),
}));

// Stubbed until there's a feed to read from. One event is the whole shape the
// hero's right column needs today.
const year = new Date().getFullYear();

const upcoming = {
  name: "Hacklanta II",
  when: "oct 9 – 11",
  href: "https://hacklanta.dev/",
  cta: "event details",
};
---

<Layout
  title="the gsu builders' wiki"
  description="an open wiki for gsu students breaking into tech — guides on internships, interviews, resumes, and networking, written by students who've been through it."
  fullBleed
>
  <HeroBand
    eyebrow="an open wiki · by progsu"
    title={'the open wiki for <br><span class="hero__accent">breaking into tech.</span>'}
    subtitle="written by gsu students who have already broken in."
    topicsLabel="browse"
    topics={topics}
    eventLabel="up next"
    event={upcoming}
    railLabel="recently updated"
    recent={recent}
    colophon={`© ${year} progsu`}
  >
    <a class="btn btn--brand btn--lg" href="/guides"> start reading → </a>
  </HeroBand>
</Layout>

<style>
  @media (max-width: 640px) {
    /* Mobile hit target: the hero button goes full width. */
    .btn--lg {
      width: 100%;
      min-height: 44px;
    }
  }
</style>
