---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";

const DAYS = ["Mon", "Tue", "Wed", "Thu", "Fri"] as const;
const START_HOUR = 7;
const END_HOUR = 21;
const SLOTS = (END_HOUR - START_HOUR) * 2;

function timeLabel(slot: number) {
  const totalMin = START_HOUR * 60 + slot * 30;
  const h = Math.floor(totalMin / 60);
  const m = totalMin % 60;
  const suffix = h >= 12 ? "p" : "a";
  const h12 = h > 12 ? h - 12 : h === 0 ? 12 : h;
  return m === 0 ? `${h12}${suffix}` : "";
}
---

<Layout
  title="shared schedule"
  description="A schedule someone shared with you — copy it into your own scheduler."
>
  <Breadcrumb items={[{ label: "courses", href: "/courses" }, { label: "shared schedule" }]} />

  <header class="share-header">
    <h1 class="share-title">shared schedule</h1>
    <p class="share-subtitle" id="share-subtitle">loading...</p>
  </header>

  <!-- Empty state: no ?s= param or invalid -->
  <div class="share-empty" id="share-empty" style="display:none">
    <p class="share-empty__text">no schedule found.</p>
    <p class="share-empty__hint">
      open the <a href="/courses/scheduler">scheduler</a> to build one.
    </p>
  </div>

  <!-- Schedule content -->
  <div id="share-content" style="display:none">
    <!-- Grid -->
    <div class="share-grid-wrap">
      <div class="share-grid" id="share-grid" style={`--rows: ${SLOTS}; --cols: ${DAYS.length}`}>
        <div class="grid-corner"></div>
        {DAYS.map((d) => <div class="grid-day-header">{d}</div>)}
        {
          Array.from({ length: SLOTS }).map((_, slot) => (
            <Fragment>
              <div class:list={["grid-time", { "grid-time--labeled": timeLabel(slot) }]}>
                {timeLabel(slot) && <span>{timeLabel(slot)}</span>}
              </div>
              {DAYS.map((day) => (
                <div class="grid-cell" data-day={day} data-slot={slot} />
              ))}
            </Fragment>
          ))
        }
      </div>
    </div>

    <!-- Course list -->
    <div class="share-courses" id="share-courses"></div>

    <!-- Summary -->
    <div class="share-summary" id="share-summary"></div>

    <!-- Action -->
    <div class="share-actions">
      <button class="btn btn--brand share-cta" type="button" id="copy-to-plans"
        >copy to my schedules</button
      >
      <a class="share-link" href="/courses/scheduler">open scheduler</a>
    </div>
  </div>
</Layout>

<style>
  .share-header {
    margin-bottom: var(--space-8);
  }

  .share-title {
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-2);
  }

  .share-subtitle {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--c-text-3);
    margin: 0;
  }

  /* ── Empty ── */
  .share-empty {
    text-align: center;
    padding: var(--space-12) var(--space-8);
    background: var(--c-bg-soft);
    border: 1px solid var(--c-divider);
    border-radius: var(--radius-lg);
  }
  .share-empty__text {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--c-text-1);
    margin: 0 0 var(--space-2);
  }
  .share-empty__hint {
    font-size: var(--text-sm);
    color: var(--c-text-2);
    margin: 0;
    line-height: var(--leading-normal);
  }
  .share-empty__hint a {
    color: var(--c-brand-1);
    font-weight: 500;
  }
  .share-empty__hint a:hover {
    text-decoration: underline;
  }

  /* ── Grid ── */
  .share-grid-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    background: var(--c-bg);
    border: 1px solid var(--c-divider);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-8);
  }

  .share-grid {
    display: grid;
    grid-template-columns: 40px repeat(var(--cols), 1fr);
    grid-template-rows: 32px repeat(var(--rows), 20px);
    position: relative;
    min-width: 500px;
  }

  .grid-corner {
    grid-column: 1;
    grid-row: 1;
    background: var(--c-bg-soft);
    border-bottom: 1px solid var(--c-divider);
    border-right: 1px solid var(--c-divider);
  }

  .grid-day-header {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--c-text-2);
    background: var(--c-bg-soft);
    border-bottom: 1px solid var(--c-divider);
    border-right: 1px solid var(--c-divider);
  }
  .grid-day-header:last-of-type {
    border-right: none;
  }

  .grid-time {
    display: flex;
    align-items: start;
    justify-content: flex-end;
    padding: 0 var(--space-2) 0 0;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    color: var(--c-text-3);
    border-right: 1px solid var(--c-divider);
    position: relative;
  }
  .grid-time--labeled {
    border-top: 1px solid var(--c-divider);
  }
  .grid-time span {
    position: relative;
    top: -0.4em;
  }

  .grid-cell {
    border-right: 1px solid var(--c-divider);
  }

  /* ── Shared course blocks ── */
  :global(.share-block) {
    border-radius: var(--radius-sm);
    border: 1px solid;
    padding: var(--space-1) var(--space-2);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1px;
    overflow: hidden;
    z-index: 2;
    margin: 1px;
  }
  :global(.share-block__code) {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 600;
    color: var(--c-text-1);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  :global(.share-block__room) {
    font-family: var(--font-mono);
    font-size: 0.5rem;
    color: var(--c-text-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ── Course list ── */
  .share-courses {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  :global(.share-course) {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    background: var(--c-bg-soft);
    border: 1px solid var(--c-divider);
    border-radius: var(--radius-lg);
  }

  :global(.share-course__dot) {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    flex-shrink: 0;
  }

  :global(.share-course__info) {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  :global(.share-course__code) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--c-brand-1);
  }

  :global(.share-course__title) {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--c-text-1);
  }

  :global(.share-course__meta) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--c-text-3);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-1);
  }

  :global(.share-course__credits) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--c-text-3);
    flex-shrink: 0;
  }

  /* ── Summary ── */
  .share-summary {
    padding: var(--space-5);
    background: var(--c-bg-soft);
    border: 1px solid var(--c-divider);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-8);
    display: flex;
    gap: var(--space-8);
    flex-wrap: wrap;
  }

  :global(.share-stat) {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  :global(.share-stat__val) {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--c-text-1);
  }

  :global(.share-stat__key) {
    font-size: var(--text-xs);
    color: var(--c-text-3);
  }

  /* ── Actions ── */
  .share-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-12);
  }

  .share-cta:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .share-link {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--c-text-2);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease);
  }
  .share-link:hover {
    color: var(--c-brand-1);
  }

  @media (max-width: 640px) {
    .share-summary {
      gap: var(--space-6);
    }
    .share-grid-wrap {
      display: none;
    }
    .share-cta {
      width: 100%;
    }
    .share-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .share-link {
      text-align: center;
    }
  }
</style>

<script>
  import { catalog, DAYS, subjectColors, toSlot, fmtTime } from "../../scripts/courseCatalog";
  import * as store from "../../scripts/scheduleStore";
  import type { ResolvedEntry } from "../../scripts/scheduleStore";

  const shareGrid = document.getElementById("share-grid")!;
  const shareCourses = document.getElementById("share-courses")!;
  const shareSummary = document.getElementById("share-summary")!;
  const shareContent = document.getElementById("share-content")!;
  const shareEmpty = document.getElementById("share-empty")!;
  const shareSubtitle = document.getElementById("share-subtitle")!;
  const copyBtn = document.getElementById("copy-to-plans") as HTMLButtonElement;

  function fmtT(h: number, m: number) {
    return fmtTime(h, m);
  }

  // The catalog palette is authored as translucent fills; the solid hue reads
  // as a colour key at dot size in both themes.
  function solidHue(fill: string) {
    return fill.replace(/rgba\(([^)]+),\s*[\d.]+\)/, "rgb($1)");
  }

  function parseShareParam(): { code: string; sectionId: string }[] {
    const params = new URLSearchParams(location.search);
    const raw = params.get("s");
    if (!raw) return [];
    return raw
      .split(",")
      .map((pair) => {
        const [codePart, sectionId] = pair.split(":");
        if (!codePart || !sectionId) return null;
        const code = codePart.replace(/^([A-Z]+)(\d)/, "$1 $2");
        return { code, sectionId };
      })
      .filter(Boolean) as { code: string; sectionId: string }[];
  }

  const entries = parseShareParam();
  const resolved = store.resolve(entries);

  if (resolved.length === 0) {
    shareEmpty.style.display = "";
    shareContent.style.display = "none";
    shareSubtitle.textContent = "invalid or empty link.";
  } else {
    shareEmpty.style.display = "none";
    shareContent.style.display = "";
    shareSubtitle.textContent = `${resolved.length} course${resolved.length !== 1 ? "s" : ""}`;

    // Render grid blocks
    for (const s of resolved) {
      const c = subjectColors[s.course.subject] ?? subjectColors.CSC;
      const startSlot = toSlot(s.section.startH, s.section.startM);
      const endSlot = toSlot(s.section.endH, s.section.endM);
      const span = Math.round(endSlot - startSlot);
      for (const day of s.section.days) {
        const col = DAYS.indexOf(day as any) + 2;
        const row = Math.round(startSlot) + 2;
        const el = document.createElement("div");
        el.className = "share-block";
        el.style.cssText = `grid-column:${col};grid-row:${row}/span ${span};background:linear-gradient(${c.bg}, ${c.bg}), linear-gradient(${c.bg}, ${c.bg}), var(--c-bg);border-color:${c.border}`;
        el.innerHTML = `<span class="share-block__code">${s.code}</span><span class="share-block__room">${s.section.room}</span>`;
        shareGrid.appendChild(el);
      }
    }

    // Render course list
    for (const s of resolved) {
      const c = subjectColors[s.course.subject] ?? subjectColors.CSC;
      const el = document.createElement("div");
      el.className = "share-course";
      el.innerHTML = `
        <span class="share-course__dot" style="background:${solidHue(c.bg)}"></span>
        <div class="share-course__info">
          <span class="share-course__code">${s.code}</span>
          <span class="share-course__title">${s.course.title}</span>
          <div class="share-course__meta">
            <span>${s.section.professor}</span>
            <span>${s.section.days.join("/")} ${fmtT(s.section.startH, s.section.startM)}–${fmtT(s.section.endH, s.section.endM)}</span>
            <span>${s.section.room}</span>
          </div>
        </div>
        <span class="share-course__credits">${s.course.credits} cr</span>
      `;
      shareCourses.appendChild(el);
    }

    // Render summary
    const stats = store.computeStats(resolved);
    const earlyStr = fmtT(Math.floor(stats.earliestMin / 60), stats.earliestMin % 60);
    const lateStr = fmtT(Math.floor(stats.latestMin / 60), stats.latestMin % 60);

    shareSummary.innerHTML = `
      <div class="share-stat"><span class="share-stat__val">${stats.credits}</span><span class="share-stat__key">credits</span></div>
      <div class="share-stat"><span class="share-stat__val">${stats.contactHours}h</span><span class="share-stat__key">contact/wk</span></div>
      <div class="share-stat"><span class="share-stat__val">${earlyStr}</span><span class="share-stat__key">earliest</span></div>
      <div class="share-stat"><span class="share-stat__val">${lateStr}</span><span class="share-stat__key">latest</span></div>
      <div class="share-stat"><span class="share-stat__val">${stats.daysOff.length > 0 ? stats.daysOff.join(", ") : "none"}</span><span class="share-stat__key">days off</span></div>
    `;
  }

  // Copy to my schedules
  copyBtn.addEventListener("click", () => {
    if (resolved.length === 0) return;
    const all = store.getAllSchedules();
    const names = new Set(all.map((s) => s.name));
    let name = "Shared";
    let i = 2;
    while (names.has(name)) {
      name = `Shared ${i++}`;
    }

    const newSched = store.duplicateSchedule(all[0].id, name);
    newSched.courses = resolved.map((r) => ({ code: r.code, sectionId: r.sectionId }));
    store.updateSchedule(newSched);
    store.setActive(newSched.id);

    copyBtn.textContent = "copied — opening scheduler...";
    copyBtn.disabled = true;
    setTimeout(() => {
      location.href = "/courses/scheduler";
    }, 800);
  });
</script>
