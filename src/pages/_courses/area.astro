---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import PageHeader from "../../components/PageHeader.astro";
import Zone from "../../components/courses/Zone.astro";
import ScheduleTray from "../../components/courses/ScheduleTray.astro";
import CourseDetailOverlay from "../../components/courses/CourseDetailOverlay.astro";
---

<Layout
  title="cs core"
  description="The required computer science courses at Georgia State, with student notes."
>
  <Breadcrumb items={[{ label: "courses", href: "/courses" }, { label: "cs core" }]} />

  <PageHeader
    title="the classes that define the degree."
    intro="required computer science courses at georgia state. open any card for details and student notes."
  />

  <section class="area-filters">
    <Zone label="filter rail · semester · prereqs met · credit hours · sort" height="44px" />
  </section>

  <section class="area-grid">
    <div class="course-cards">
      {
        Array.from({ length: 6 }).map((_, i) => (
          <div class="course-card card card--link">
            <div class="course-card__head">
              <span class="course-card__number">CSC {String(1010 + i * 400).slice(0, 4)}</span>
              <span class="course-card__credits">3 cr</span>
            </div>
            <span class="course-card__title">Course title placeholder</span>
            <span class="course-card__take">student take goes here</span>
          </div>
        ))
      }
    </div>
  </section>

  <div class="tray-spacer"></div>
  <ScheduleTray />
  <CourseDetailOverlay />
</Layout>

<style>
  .area-filters {
    margin-bottom: var(--space-8);
  }

  .course-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-bottom: var(--space-24);
  }

  .course-card.card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    cursor: pointer;
  }

  .course-card__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .course-card__number {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--c-brand-1);
  }

  .course-card__credits {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--c-text-3);
  }

  .course-card__title {
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    color: var(--c-text-1);
  }

  .course-card__take {
    font-size: var(--text-sm);
    color: var(--c-text-2);
    line-height: var(--leading-normal);
  }

  .tray-spacer {
    height: 80px;
  }

  @media (max-width: 640px) {
    .course-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
