---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import CoursesSubnav from "../../components/CoursesSubnav.astro";
import Zone from "../../components/courses/Zone.astro";
---

<Layout
  title="semester plans"
  description="Pre-built semester schedules from progsu members, ready to copy and adjust."
>
  <CoursesSubnav active="plans" />

  <PageHeader
    title="start from something that already worked."
    intro="pre-built schedules from progsu members. copy one as a starting point, then make it yours."
  />

  <section class="plans">
    <div class="plan card">
      <div class="plan__head">
        <span class="plan__title">typical CS sophomore fall</span>
        <span class="plan__meta">5 courses &middot; 15 credits</span>
      </div>
      <p class="plan__desc">
        The standard second-year load. Data structures, calc II, and the first real systems class.
      </p>
      <Zone label="course list preview · 5 course pills" height="48px" />
      <Zone label="copy to my schedule button" height="44px" />
    </div>

    <div class="plan card">
      <div class="plan__head">
        <span class="plan__title">catch-up summer</span>
        <span class="plan__meta">3 courses &middot; 9 credits</span>
      </div>
      <p class="plan__desc">
        Behind on math or science credits? This clears the backlog without burning out.
      </p>
      <Zone label="course list preview · 3 course pills" height="48px" />
      <Zone label="copy to my schedule button" height="44px" />
    </div>

    <div class="plan card plan--draft">
      <div class="plan__head">
        <span class="plan__title">senior capstone spring</span>
        <span class="plan__meta">4 courses &middot; 13 credits</span>
        <span class="badge plan__badge">in progress</span>
      </div>
      <p class="plan__desc">
        Capstone, one elective, and the last gen-ed. Light enough to job-hunt alongside.
      </p>
      <Zone label="course list preview · 4 course pills" height="48px" />
      <Zone label="copy to my schedule button" height="44px" />
    </div>
  </section>
</Layout>

<style>
  .plans {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .plan.card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .plan--draft {
    background: var(--c-bg);
    border-style: dashed;
  }

  .plan__head {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .plan__title {
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    color: var(--c-text-1);
  }

  .plan__meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--c-text-3);
  }

  .plan__badge {
    margin-left: auto;
  }

  .plan__desc {
    font-size: var(--text-sm);
    color: var(--c-text-2);
    line-height: var(--leading-normal);
    margin: 0;
    max-width: 60ch;
  }

  @media (max-width: 480px) {
    .plan.card {
      padding: var(--space-5);
    }
    .plan__badge {
      margin-left: 0;
    }
  }
</style>
