---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import SiteSearch from "../components/SiteSearch.astro";
import "../styles/global.css";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
  accent?: 'purple' | 'cyan';
}

const { title, description, wide = false, accent } = Astro.props;
---

<!doctype html>
<html lang="en" data-accent={accent}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description ?? SITE_DESCRIPTION} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | {SITE_TITLE}</title>
  </head>
  <body>
    <!-- Cosmic background, matches the ConstellationGraph home hero -->
    <div class="bg-nebula" aria-hidden="true"></div>
    <div class="bg-nebula bg-nebula--deep" aria-hidden="true"></div>
    <div class="bg-stars bg-stars--far" aria-hidden="true"></div>
    <div class="bg-stars bg-stars--mid" aria-hidden="true"></div>
    <div class="bg-stars bg-stars--near" aria-hidden="true"></div>
    <div class="bg-vignette" aria-hidden="true"></div>

    <Navbar />

    <main id="main-content" class:list={['layout-main', { 'layout-main--wide': wide }]}>
      <slot />
    </main>

    <Footer />

    <SiteSearch />

    <!-- Keyboard shortcuts modal -->
    <div class="kbd-modal-backdrop" id="kbd-modal-backdrop" role="dialog" aria-label="Keyboard shortcuts" aria-modal="true">
      <div class="kbd-modal">
        <h2 class="kbd-modal__title">keyboard shortcuts</h2>

        <div class="kbd-modal__group">
          <h3 class="kbd-modal__group-label">navigation</h3>
          <div class="kbd-modal__row">
            <span class="kbd-modal__action">focus search</span>
            <span class="kbd-modal__keys"><kbd class="kbd-modal__key">/</kbd></span>
          </div>
        </div>

        <div class="kbd-modal__group">
          <h3 class="kbd-modal__group-label">general</h3>
          <div class="kbd-modal__row">
            <span class="kbd-modal__action">show this dialog</span>
            <span class="kbd-modal__keys"><kbd class="kbd-modal__key">?</kbd></span>
          </div>
        </div>

        <button class="kbd-modal__close" id="kbd-modal-close">close (esc)</button>
      </div>
    </div>

    <script>
      const kbdBackdrop = document.getElementById('kbd-modal-backdrop')!;
      const kbdClose = document.getElementById('kbd-modal-close')!;

      function openKbdModal() {
        kbdBackdrop.classList.add('open');
        kbdClose.focus();
      }
      function closeKbdModal() {
        kbdBackdrop.classList.remove('open');
      }

      kbdClose.addEventListener('click', closeKbdModal);
      kbdBackdrop.addEventListener('click', (e) => {
        if (e.target === kbdBackdrop) closeKbdModal();
      });

      window.addEventListener('keydown', (e: KeyboardEvent) => {
        const tag = (document.activeElement as HTMLElement)?.tagName;
        const inInput = tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' ||
          (document.activeElement as HTMLElement)?.isContentEditable;

        if (e.key === 'Escape' && kbdBackdrop.classList.contains('open')) {
          e.preventDefault();
          closeKbdModal();
          return;
        }

        if (inInput) return;

        if (e.key === '?' && !e.ctrlKey && !e.metaKey) {
          e.preventDefault();
          if (kbdBackdrop.classList.contains('open')) closeKbdModal();
          else openKbdModal();
          return;
        }
      });
    </script>
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    position: relative;
    overflow-x: hidden;
  }

  /* ── Cosmic layers, matches ConstellationGraph's .layer-nebula/.layer-stars/.vignette ── */
  .bg-nebula {
    position: fixed;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 50% at 50% 45%, rgba(76,29,149,.35), transparent 70%),
      radial-gradient(ellipse 50% 40% at 20% 75%, rgba(30,27,75,.5),   transparent 65%),
      radial-gradient(ellipse 50% 40% at 80% 20%, rgba(13,42,90,.4),   transparent 65%),
      linear-gradient(180deg, #02020a 0%, #050516 50%, #02020a 100%);
    pointer-events: none;
    z-index: 0;
  }

  .bg-nebula--deep {
    inset: -15%;
    background:
      radial-gradient(ellipse 80% 60% at 45% 40%, rgba(76,29,149,.30), transparent 70%),
      radial-gradient(ellipse 60% 55% at 75% 65%, rgba(124,58,237,.22), transparent 65%),
      radial-gradient(ellipse 70% 50% at 25% 70%, rgba(139,92,246,.20), transparent 60%),
      radial-gradient(ellipse 90% 70% at 55% 50%, rgba(30,27,75,.40), transparent 75%),
      radial-gradient(ellipse 50% 45% at 80% 30%, rgba(76,29,149,.18), transparent 60%),
      radial-gradient(ellipse 55% 50% at 15% 35%, rgba(168,85,247,.14), transparent 55%),
      radial-gradient(ellipse 100% 80% at 50% 55%, rgba(76,29,149,.12), transparent 80%);
    will-change: transform;
    animation: driftNebula 200s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .bg-nebula--deep { animation: none; }
  }

  .bg-stars {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    will-change: transform;
  }
  .bg-stars--far {
    background-image:
      radial-gradient(1px 1px at 12% 23%, rgba(255,255,255,.5), transparent),
      radial-gradient(1px 1px at 78% 67%, rgba(255,255,255,.4), transparent),
      radial-gradient(1px 1px at 34% 81%, rgba(255,255,255,.45), transparent),
      radial-gradient(1px 1px at 88% 14%, rgba(255,255,255,.5), transparent),
      radial-gradient(1px 1px at 5%  55%, rgba(255,255,255,.35), transparent),
      radial-gradient(1px 1px at 65% 30%, rgba(255,255,255,.3), transparent),
      radial-gradient(1px 1px at 25% 8%,  rgba(255,255,255,.4), transparent),
      radial-gradient(1px 1px at 95% 88%, rgba(255,255,255,.4), transparent),
      radial-gradient(1px 1px at 45% 18%, rgba(255,255,255,.3), transparent),
      radial-gradient(1px 1px at 15% 75%, rgba(255,255,255,.5), transparent),
      radial-gradient(1px 1px at 55% 92%, rgba(255,255,255,.35), transparent),
      radial-gradient(1px 1px at 38% 45%, rgba(255,255,255,.25), transparent);
    background-size: 280px 280px;
    animation: driftFar 180s linear infinite;
    opacity: .7;
  }
  .bg-stars--mid {
    background-image:
      radial-gradient(1.5px 1.5px at 22% 33%, rgba(255,255,255,.7), transparent),
      radial-gradient(1.5px 1.5px at 68% 57%, rgba(216,180,254,.6), transparent),
      radial-gradient(1.5px 1.5px at 84% 31%, rgba(255,255,255,.65), transparent),
      radial-gradient(1.5px 1.5px at 8%  65%, rgba(255,255,255,.6), transparent),
      radial-gradient(1.5px 1.5px at 92% 78%, rgba(186,230,253,.55), transparent),
      radial-gradient(1.5px 1.5px at 48% 88%, rgba(255,255,255,.5), transparent),
      radial-gradient(1.5px 1.5px at 33% 12%, rgba(255,255,255,.55), transparent),
      radial-gradient(1.5px 1.5px at 72% 8%,  rgba(216,180,254,.5), transparent);
    background-size: 380px 380px;
    animation: driftMid 120s linear infinite;
    opacity: .85;
  }
  .bg-stars--near {
    background-image:
      radial-gradient(2px 2px at 18% 73%, rgba(255,255,255,.95) 0%, rgba(255,255,255,.4) 30%, transparent 60%),
      radial-gradient(2px 2px at 73% 22%, rgba(216,180,254,.85) 0%, rgba(216,180,254,.3) 30%, transparent 60%),
      radial-gradient(2px 2px at 87% 84%, rgba(255,255,255,.9) 0%, rgba(255,255,255,.35) 30%, transparent 60%),
      radial-gradient(2px 2px at 6%  26%, rgba(186,230,253,.8) 0%, rgba(186,230,253,.3) 30%, transparent 60%);
    background-size: 480px 480px;
    animation: driftNear 80s linear infinite;
    opacity: .9;
  }

  @media (prefers-reduced-motion: reduce) {
    .bg-stars--far, .bg-stars--mid, .bg-stars--near { animation: none; }
  }

  @keyframes driftFar    { from { transform: translate(0,0) }   to { transform: translate(60px,40px) } }
  @keyframes driftMid    { from { transform: translate(0,0) }   to { transform: translate(-80px,50px) } }
  @keyframes driftNear   { from { transform: translate(0,0) }   to { transform: translate(100px,-60px) } }
  @keyframes driftNebula { from { transform: translate(0,0) }   to { transform: translate(40px,25px) } }

  .bg-vignette {
    position: fixed;
    inset: 0;
    background: radial-gradient(ellipse 95% 80% at 50% 50%, transparent 40%, rgba(0,0,0,.65) 95%);
    pointer-events: none;
    z-index: 0;
  }

  /* ── Main content ── */
  .layout-main {
    position: relative;
    z-index: var(--z-base);
    flex: 1;
    max-width: var(--page-width);
    margin: 0 auto;
    width: 100%;
    padding: var(--space-24) var(--page-gutter) var(--space-16);
  }

  .layout-main--wide {
    max-width: var(--page-width-wide);
  }

  @media (max-width: 768px) {
    .layout-main {
      padding-top: var(--space-20);
      padding-bottom: var(--space-12);
    }
  }
</style>
