---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";

import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import SiteSearch from "../components/SiteSearch.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

interface Props {
  title: string;
  description?: string;
  /** Widens the content container from 688px to 1104px. */
  wide?: boolean;
  /** Drops the container entirely, for full-bleed landing pages. */
  fullBleed?: boolean;
  /**
   * The page renders a fixed sidebar rail. The footer sits outside <main>, so
   * it has to be inset by the same amount or the rail covers it.
   */
  sidebar?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  wide = false,
  fullBleed = false,
  sidebar = false,
} = Astro.props;

const pageTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://wiki.progsu.com");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    {/* Runs before first paint so the page never flashes the wrong theme. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("progsu-theme");
          var dark = stored
            ? stored === "dark"
            : window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.classList.toggle("dark", dark);
        } catch (e) {}
      })();
    </script>
  </head>

  <body>
    <Navbar />

    <main
      id="main-content"
      class:list={["layout-main", { "layout-main--wide": wide, "layout-main--bleed": fullBleed }]}
    >
      <slot />
    </main>

    <div class:list={["layout-foot", { "layout-foot--sidebar": sidebar }]}>
      <Footer />
    </div>
    <SiteSearch />

    <div
      class="kbd-modal-backdrop"
      id="kbd-modal-backdrop"
      role="dialog"
      aria-modal="true"
      aria-labelledby="kbd-modal-title"
      hidden
    >
      <div class="kbd-modal">
        <h2 class="kbd-modal__title" id="kbd-modal-title">keyboard shortcuts</h2>
        <div class="kbd-modal__row">
          <span class="kbd-modal__action">search</span>
          <span class="kbd-modal__keys"><kbd class="kbd-modal__key">/</kbd></span>
        </div>
        <div class="kbd-modal__row">
          <span class="kbd-modal__action">this dialog</span>
          <span class="kbd-modal__keys"><kbd class="kbd-modal__key">?</kbd></span>
        </div>
        <button class="kbd-modal__close" type="button" id="kbd-modal-close">close</button>
      </div>
    </div>

    <style>
      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      .layout-main {
        flex: 1;
        width: 100%;
        max-width: calc(var(--page-width) + 2 * var(--space-6));
        margin-inline: auto;
        padding: var(--space-16) var(--page-gutter) var(--space-24);
      }

      .layout-main--wide {
        max-width: calc(var(--page-width-wide) + 2 * var(--space-6));
      }

      /* Landing pages paint their own bands edge to edge. */
      .layout-main--bleed {
        max-width: none;
        margin-inline: 0;
        padding: 0;
      }

      @media (max-width: 768px) {
        .layout-main:not(.layout-main--bleed) {
          padding: var(--space-10) var(--page-gutter) var(--space-16);
        }
      }

      /* The sidebar is position:fixed and spans the full viewport height, so it
         covers anything laid out at x=0 — including the footer, which is a
         sibling of <main> and never saw .doc__main's padding. These mirror
         .doc__main's offsets exactly; the two must stay in step. */
      @media (min-width: 960px) {
        .layout-foot--sidebar {
          padding-left: var(--sidebar-width);
        }
      }

      @media (min-width: 1440px) {
        .layout-foot--sidebar {
          padding-left: calc((100vw - var(--layout-max-width)) / 2 + var(--sidebar-width));
          padding-right: calc((100vw - var(--layout-max-width)) / 2);
        }
      }
    </style>

    <script>
      // ── Keyboard shortcuts ──────────────────────────────────────
      const backdrop = document.getElementById("kbd-modal-backdrop");
      const closeBtn = document.getElementById("kbd-modal-close");
      let lastFocused: HTMLElement | null = null;

      function isTyping(el: EventTarget | null) {
        const node = el as HTMLElement | null;
        if (!node) return false;
        const tag = node.tagName;
        return tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT" || node.isContentEditable;
      }

      function closeKbdModal() {
        if (!backdrop) return;
        backdrop.hidden = true;
        backdrop.classList.remove("open");
        lastFocused?.focus();
      }

      function openKbdModal() {
        if (!backdrop) return;
        lastFocused = document.activeElement as HTMLElement;
        backdrop.hidden = false;
        backdrop.classList.add("open");
        closeBtn?.focus();
      }

      document.addEventListener("keydown", (e) => {
        if (isTyping(e.target)) return;
        if (e.key === "?" && !e.metaKey && !e.ctrlKey) {
          e.preventDefault();
          backdrop?.hidden ? openKbdModal() : closeKbdModal();
        }
        if (e.key === "Escape" && backdrop && !backdrop.hidden) closeKbdModal();
      });

      closeBtn?.addEventListener("click", closeKbdModal);
      backdrop?.addEventListener("click", (e) => {
        if (e.target === backdrop) closeKbdModal();
      });

      // ── Code block copy buttons ─────────────────────────────────
      // Progressive enhancement: the language label is CSS-only, this
      // just adds the button. `pre` doesn't scroll (its `code` does),
      // so an absolutely positioned button stays pinned.
      const COPY_ICON = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>`;
      const DONE_ICON = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>`;

      document.querySelectorAll<HTMLPreElement>("pre.astro-code").forEach((pre) => {
        if (pre.querySelector(".code-copy")) return;

        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "code-copy";
        btn.setAttribute("aria-label", "copy code");
        btn.innerHTML = COPY_ICON;

        btn.addEventListener("click", async () => {
          const code = pre.querySelector("code");
          if (!code) return;
          try {
            await navigator.clipboard.writeText(code.innerText);
            btn.dataset.copied = "true";
            btn.innerHTML = DONE_ICON;
            btn.setAttribute("aria-label", "copied");
            setTimeout(() => {
              delete btn.dataset.copied;
              btn.innerHTML = COPY_ICON;
              btn.setAttribute("aria-label", "copy code");
            }, 2000);
          } catch {
            // Clipboard is unavailable over plain http; nothing useful to say.
          }
        });

        pre.appendChild(btn);
      });
    </script>
  </body>
</html>
