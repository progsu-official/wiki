---
import Layout from "./Layout.astro";
import Sidebar from "../components/Sidebar.astro";
import Aside from "../components/Aside.astro";
import DocFooter from "../components/DocFooter.astro";
import { getGuideNav } from "../lib/guideNav";

interface Props {
  title: string;
  description?: string;
  headings?: { depth: number; slug: string; text: string }[];
  updated?: Date;
}

const { title, description, headings = [], updated } = Astro.props;

const { flat } = await getGuideNav();
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";

const index = flat.findIndex((item) => item.link === pathname);
const prev = index > 0 ? flat[index - 1] : null;
const next = index !== -1 && index < flat.length - 1 ? flat[index + 1] : null;

const hasAside = headings.some((h) => h.depth === 2 || h.depth === 3);
---

<Layout title={title} description={description} fullBleed>
  <div class="doc">
    <div class="doc__localnav">
      <button
        class="doc__menu"
        id="sb-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="doc-sidebar"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        menu
      </button>
      <span class="doc__localnav-title">{title}</span>
    </div>

    <div class="doc__backdrop" id="sb-backdrop" hidden></div>

    <aside class="doc__sidebar" id="doc-sidebar">
      <Sidebar />
    </aside>

    <div class="doc__main">
      <div class:list={["doc__grid", { "doc__grid--with-aside": hasAside }]}>
        <article class="doc__content">
          <slot />
          <DocFooter prev={prev} next={next} updated={updated} />
        </article>

        {
          hasAside && (
            <div class="doc__aside">
              <Aside headings={headings} />
            </div>
          )
        }
      </div>
    </div>
  </div>
</Layout>

<style>
  .doc {
    position: relative;
  }

  /* ── Mobile local nav ──────────────────────────────────── */

  .doc__localnav {
    position: sticky;
    top: var(--nav-height);
    z-index: var(--z-sticky);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    height: 48px;
    padding-inline: var(--page-gutter);
    background: var(--c-bg);
    border-bottom: 1px solid var(--c-divider);
  }

  .doc__menu {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
    padding: var(--space-2) 0;
    border: none;
    background: none;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--c-text-2);
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease);
  }

  .doc__menu:hover {
    color: var(--c-brand-1);
  }

  .doc__localnav-title {
    overflow: hidden;
    font-size: var(--text-sm);
    color: var(--c-text-3);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .doc__localnav-title::before {
    content: "/";
    margin-right: var(--space-3);
    color: var(--c-divider);
  }

  /* ── Sidebar ───────────────────────────────────────────── */

  .doc__backdrop {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    background: rgba(0, 0, 0, 0.5);
  }

  .doc__backdrop[hidden] {
    display: none;
  }

  .doc__sidebar {
    position: fixed;
    top: var(--nav-height);
    bottom: 0;
    left: 0;
    z-index: calc(var(--z-overlay) + 1);
    /* Drawer sizing: near-full width, capped — same shape as vue's. */
    width: calc(100vw - 64px);
    max-width: 320px;
    padding: var(--space-6) var(--space-6) var(--space-24);
    background: var(--c-bg);
    border-right: 1px solid var(--c-divider);
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    /* A nav rail shouldn't carry the full-width page scrollbar. */
    scrollbar-width: thin;
    scrollbar-color: var(--c-border) transparent;
    transform: translateX(-100%);
    transition: transform var(--duration-normal) var(--ease);
  }

  .doc__sidebar.is-open {
    transform: translateX(0);
    box-shadow: var(--shadow-xl);
  }

  .doc__sidebar::-webkit-scrollbar {
    width: 5px;
  }

  .doc__sidebar::-webkit-scrollbar-track {
    background: transparent;
  }

  /* The global thumb insets itself with a 2px --c-bg border, which on a 5px
     track would leave a 1px sliver. */
  .doc__sidebar::-webkit-scrollbar-thumb {
    background: var(--c-border);
    border: none;
    border-radius: var(--radius-full);
  }

  .doc__sidebar::-webkit-scrollbar-thumb:hover {
    background: var(--c-text-3);
  }

  /* ── Content ───────────────────────────────────────────── */

  .doc__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    width: 100%;
    max-width: calc(var(--content-width) + 2 * var(--page-gutter));
    margin-inline: auto;
    padding: var(--space-10) var(--page-gutter) var(--space-24);
  }

  .doc__content {
    min-width: 0;
  }

  /* Above the article on narrow screens, a rail on wide ones. */
  .doc__aside {
    order: -1;
    margin-bottom: var(--space-8);
  }

  @media (min-width: 960px) {
    .doc__localnav,
    .doc__backdrop {
      display: none;
    }

    .doc__sidebar {
      z-index: var(--z-sticky);
      width: var(--sidebar-width);
      max-width: none;
      padding: var(--space-6) var(--space-6) var(--space-24) var(--space-8);
      transform: none;
      box-shadow: none;
    }

    .doc__main {
      padding-left: var(--sidebar-width);
    }

    .doc__grid {
      padding-top: var(--space-12);
    }
  }

  @media (min-width: 1280px) {
    .doc__grid--with-aside {
      grid-template-columns: minmax(0, var(--content-width)) var(--aside-width);
      gap: var(--space-16);
      max-width: calc(
        var(--content-width) + var(--aside-width) + var(--space-16) + 2 * var(--page-gutter)
      );
    }

    .doc__grid--with-aside .doc__aside {
      order: 0;
      margin-bottom: 0;
    }
  }

  /* Past --layout-max-width the page gains outer gutters. The sidebar GROWS to
     absorb the left one; padding alone would eat into its fixed 272px, leaving
     8px of usable column on a 1920px monitor and spilling its text over the
     article. The article is inset by the same amount, so the two can't overlap. */
  @media (min-width: 1440px) {
    .doc__sidebar {
      width: calc((100vw - var(--layout-max-width)) / 2 + var(--sidebar-width));
      padding-left: calc((100vw - var(--layout-max-width)) / 2 + var(--space-8));
    }

    .doc__main {
      padding-left: calc((100vw - var(--layout-max-width)) / 2 + var(--sidebar-width));
      padding-right: calc((100vw - var(--layout-max-width)) / 2);
    }
  }
</style>

<script>
  const sidebar = document.getElementById("doc-sidebar");
  const backdrop = document.getElementById("sb-backdrop");
  const toggle = document.getElementById("sb-toggle");

  if (sidebar && backdrop && toggle) {
    const setOpen = (open: boolean) => {
      sidebar.classList.toggle("is-open", open);
      backdrop.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
      // Only lock the page behind the drawer; on desktop it isn't a drawer.
      document.body.style.overflow = open ? "hidden" : "";
    };

    toggle.addEventListener("click", () => {
      setOpen(!sidebar.classList.contains("is-open"));
    });

    backdrop.addEventListener("click", () => setOpen(false));

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && sidebar.classList.contains("is-open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    // Following a link inside the drawer should close it.
    sidebar.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) setOpen(false);
    });

    // Leaving the drawer breakpoint must not strand a locked body.
    const wide = window.matchMedia("(min-width: 960px)");
    wide.addEventListener("change", (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>

<script>
  // Mermaid is ~1MB, so it only loads on the pages that actually hold a diagram.
  const diagrams = [...document.querySelectorAll<HTMLElement>(".mermaid-diagram")];

  if (diagrams.length > 0) {
    const { default: mermaid } = await import("mermaid");

    // Read fresh every time: the theme toggle rewrites these on <html>, and the
    // colours below get baked into the SVG rather than referenced from it.
    const token = (name: string) =>
      getComputedStyle(document.documentElement).getPropertyValue(name).trim();

    const configure = () =>
      mermaid.initialize({
        startOnLoad: false,
        // Diagrams come from our own vault, and clickable nodes need real hrefs.
        securityLevel: "loose",
        theme: "base",
        fontFamily: token("--font-body"),
        // useMaxWidth would scale a wide diagram down to the column and shrink the
        // text past legibility; render at native size and pick a fitting direction.
        flowchart: { curve: "basis", padding: 16, useMaxWidth: false },
        themeVariables: {
          // Nodes take --c-bg so they read against the panel's --c-bg-soft. The
          // obvious --c-bg-mute is the one pairing to avoid: the clickable labels
          // are --c-brand-1, which lands at 4.41:1 on mute in dark.
          background: token("--c-bg-soft"),
          primaryColor: token("--c-bg"),
          mainBkg: token("--c-bg"),
          secondaryColor: token("--c-bg-mute"),
          tertiaryColor: token("--c-bg-soft"),
          primaryBorderColor: token("--c-border"),
          nodeBorder: token("--c-border"),
          primaryTextColor: token("--c-text-1"),
          nodeTextColor: token("--c-text-1"),
          textColor: token("--c-text-2"),
          lineColor: token("--c-text-3"),
          edgeLabelBackground: token("--c-bg-soft"),
        },
      });

    // A horizontal flowchart is short but wide, a vertical one tall but narrow.
    // Rather than force either, try the direction the diagram asks for and fall
    // back to vertical when it would need sideways scrolling at this width.
    const HORIZONTAL = /^(\s*flowchart\s+)(LR|RL)\b/m;
    let seq = 0;

    const naturalWidth = (svg: string) => {
      const vb = /viewBox="[\d.\-]+ [\d.\-]+ ([\d.]+) [\d.]+"/.exec(svg);
      return vb ? parseFloat(vb[1]) : 0;
    };

    // clientWidth still counts the panel's padding, which the diagram can't use.
    const roomFor = (el: HTMLElement) => {
      const cs = getComputedStyle(el);
      return el.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
    };

    const paint = (el: HTMLElement, svg: string, bind?: (e: Element) => void) => {
      el.innerHTML = svg;
      bind?.(el);
      el.dataset.rendered = "true";
    };

    async function draw(el: HTMLElement, source: string) {
      if (HORIZONTAL.test(source)) {
        const wide = await mermaid.render(`mermaid-diagram-${seq++}`, source);
        if (naturalWidth(wide.svg) <= roomFor(el)) {
          paint(el, wide.svg, wide.bindFunctions);
          el.dataset.direction = "horizontal";
          return;
        }
        source = source.replace(HORIZONTAL, "$1TD");
      }
      const tall = await mermaid.render(`mermaid-diagram-${seq++}`, source);
      paint(el, tall.svg, tall.bindFunctions);
      el.dataset.direction = "vertical";
    }

    const render = () => {
      configure();
      return Promise.all(
        diagrams.map(async (el) => {
          const source = el.dataset.diagram;
          if (!source || !el.isConnected) return;
          try {
            await draw(el, source);
          } catch {
            // A malformed diagram shouldn't leave a broken slot mid-article.
            el.remove();
          }
        })
      );
    };

    await render();

    // Re-evaluate the direction when the available width changes.
    let resizeTimer: number;
    let lastWidth = window.innerWidth;
    window.addEventListener("resize", () => {
      if (window.innerWidth === lastWidth) return;
      lastWidth = window.innerWidth;
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(render, 150);
    });

    // The palette is baked into the SVG, so a theme flip needs a repaint. Watch
    // the class rather than the toggle button: the shell can set it too.
    let theme = document.documentElement.classList.contains("dark");
    new MutationObserver(() => {
      const isDark = document.documentElement.classList.contains("dark");
      if (isDark === theme) return;
      theme = isDark;
      render();
    }).observe(document.documentElement, { attributeFilter: ["class"] });
  }
</script>
